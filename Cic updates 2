// GXV-style HTF sweep validation for PO3's existing Candle arrays.
// Candle arrays are newest-first: index = C2, index + 1 = C1, index - 1 = immediate C3.
f_po3_source_closed(Candle candle, string sourceTf) =>
    candle.o_time != time(sourceTf)

f_po3_sweep_valid(array<Candle> candles, int c2Index, bool highSide, string sourceTf) =>
    bool valid = false
    bool recoveredByC3 = false
    if c2Index >= 0 and c2Index + 1 < candles.size()
        Candle c2 = candles.get(c2Index)
        Candle c1 = candles.get(c2Index + 1)
        bool c2Closed = f_po3_source_closed(c2, sourceTf)
        bool swept = highSide ? c2.h > c1.h : c2.l < c1.l
        bool reclaimed = highSide ? c2.c < c1.h : c2.c > c1.l
        bool failedC2 = highSide ? c2.c >= c1.h : c2.c <= c1.l
        bool c3Closed = c2Index > 0 ? f_po3_source_closed(candles.get(c2Index - 1), sourceTf) : false
        float c3Close = c2Index > 0 ? candles.get(c2Index - 1).c : na
        bool c3Recovery = htf_c3_closure and c3Closed and (highSide ? c3Close < c1.l : c3Close > c1.h)
        recoveredByC3 := swept and c2Closed and failedC2 and c3Recovery
        valid := swept and c2Closed and (reclaimed or recoveredByC3)
        // GXV lifecycle: a later CLOSED HTF candle closing through the swept level invalidates it.
        if valid and c2Index > 0
            for newerIndex = 0 to c2Index - 1
                Candle newer = candles.get(newerIndex)
                if f_po3_source_closed(newer, sourceTf)
                    bool broken = highSide ? newer.c > c1.h : newer.c < c1.l
                    if broken
                        valid := false
                        break
    [valid, recoveredByC3]

// GXV-style pane vote: use the latest fully closed C2 against its C1 range.
// A one-sided low sweep votes bullish; a one-sided high sweep votes bearish.
f_gxv_pane_bias(CandleSet pane, bool enabled) =>
    int direction = 0
    if enabled and pane.settings.show and pane.candles.size() > 2
        [sweptHigh, highC3Recovery] = f_po3_sweep_valid(pane.candles, 1, true, pane.settings.htf)
        [sweptLow, lowC3Recovery] = f_po3_sweep_valid(pane.candles, 1, false, pane.settings.htf)
        direction := sweptHigh == sweptLow ? 0 : sweptLow ? 1 : -1
    direction

f_gxv_bias_agreement(int enabledCount, int direction1, int direction2, int direction3) =>
    int bulls = (direction1 == 1 ? 1 : 0) + (direction2 == 1 ? 1 : 0) + (direction3 == 1 ? 1 : 0)
    int bears = (direction1 == -1 ? 1 : 0) + (direction2 == -1 ? 1 : 0) + (direction3 == -1 ? 1 : 0)
    int required = enabledCount == 1 ? 1 : 2
    enabledCount == 0 ? 0 : bulls >= required ? 1 : bears >= required ? -1 : 0

