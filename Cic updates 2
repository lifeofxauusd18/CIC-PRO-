                    candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_up, size = settings.htf_timer_size)
    candleSet

method FindImbalance(CandleSet candleSet) =>
    if barstate.isrealtime or barstate.islast
        if candleSet.imbalances.size() > 0
            for i = candleSet.imbalances.size() - 1 to 0 by 1
                Imbalance del = candleSet.imbalances.get(i)
                box.delete(del.b)
                candleSet.imbalances.pop()
        if candleSet.candles.size() > 2 and htf_fvg_show
            int count = candleSet.candles.size()
            int htfSeconds = timeframe.in_seconds(candleSet.settings.htf)
            int htfMs = na(htfSeconds) ? na : htfSeconds * 1000
            for i = 0 to count - 3
                Candle c3 = candleSet.candles.get(i)
                Candle c2 = candleSet.candles.get(i + 1)
                Candle c1 = candleSet.candles.get(i + 2)
                bool closed = c1.o_time != time(candleSet.settings.htf) and c2.o_time != time(candleSet.settings.htf)
                bool chronological = c1.o_time < c2.o_time and c2.o_time < c3.o_time
                bool noTimeVoid = na(htfMs) ? true : (c2.o_time - c1.o_time <= htfMs * 2 and c3.o_time - c2.o_time <= htfMs * 2)
                bool validTriplet = closed and chronological and noTimeVoid
                bool bullFvg = validTriplet and c3.l > c1.h
                bool bearFvg = validTriplet and c3.h < c1.l
                int fvgRight = i == 0 and c3.o_time == time(candleSet.settings.htf) ? box.get_left(c3.body) : box.get_right(c3.body)
                int fvgLeft = box.get_right(c2.body)
                if fvgRight > fvgLeft and bullFvg
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(fvgLeft, c3.l, fvgRight, c1.h, xloc = xloc.bar_index, bgcolor = color.new(htf_bull_fvg_color, 90), border_color = color.new(color.white, 100))
                    candleSet.imbalances.push(imb)
                if fvgRight > fvgLeft and bearFvg
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(fvgLeft, c1.l, fvgRight, c3.h, xloc = xloc.bar_index, bgcolor = color.new(htf_bear_fvg_color, 90), border_color = color.new(color.white, 100))
                    candleSet.imbalances.push(imb)
        if candleSet.candles.size() > 2 and settings.vi_show
            for i = 0 to candleSet.candles.size() - 2 by 1
                candle1 = candleSet.candles.get(i)
                candle2 = candleSet.candles.get(i + 1)
                if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_left(candle2.body), math.min(candle1.o, candle1.c), box.get_right(candle1.body), math.max(candle2.o, candle2.c), bgcolor = settings.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
                if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_right(candle1.body), math.min(candle2.o, candle2.c), box.get_left(candle2.body), math.max(candle1.o, candle1.c), bgcolor = settings.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
    candleSet

// Exact peak finder: scans the real chart bars that belong to ONE HTF candle.
f_exactPeak(int startIdx, int endIdx, bool wantHigh, int fbIdx, float fbPx) =>
    int bestIdx = fbIdx
    float bestPx = fbPx
    int s = math.max(startIdx, bar_index - 4900)
    int e = math.min(endIdx, bar_index)
    if s <= e
        float ext = wantHigh ? -1e18 : 1e18
        for i = s to e
            float px = wantHigh ? high[bar_index - i] : low[bar_index - i]
            bool better = wantHigh ? px > ext : px < ext
            if better
                ext := px
                bestIdx := i
                bestPx := px
    [bestIdx, bestPx]

// GXV-style HTF SMT and PSP overlays; PO3 HTF sweep lines remain active.
f_htf_smt_invalidated(array<Candle> candles, int candleIndex, bool bull) =>
    bool invalidated = false
    if candleIndex > 0 and candleIndex < candles.size()
        Candle source = candles.get(candleIndex)
        for index = 0 to candleIndex - 1
            Candle newer = candles.get(index)
            invalidated := invalidated or (bull ? newer.l < source.l : newer.h > source.h)
    invalidated

f_htf_pair_bull_smt(Candle source, Candle previous, int pair) =>
    bool enabled = pair == 1 ? source.smt_use1 and previous.smt_use1 : pair == 2 ? source.smt_use2 and previous.smt_use2 : pair == 3 ? source.smt_use3 and previous.smt_use3 : source.smt_use4 and previous.smt_use4
    bool valid = pair == 1 ? source.smt_valid1 and previous.smt_valid1 : pair == 2 ? source.smt_valid2 and previous.smt_valid2 : pair == 3 ? source.smt_valid3 and previous.smt_valid3 : source.smt_valid4 and previous.smt_valid4
    float sourceLow = pair == 1 ? source.smt_l1 : pair == 2 ? source.smt_l2 : pair == 3 ? source.smt_l3 : source.smt_l4
    float previousLow = pair == 1 ? previous.smt_l1 : pair == 2 ? previous.smt_l2 : pair == 3 ? previous.smt_l3 : previous.smt_l4
    bool ready = enabled and valid and not na(sourceLow) and not na(previousLow)
    ready and ((source.l < previous.l and sourceLow > previousLow) or (source.l > previous.l and sourceLow < previousLow))

f_htf_pair_bear_smt(Candle source, Candle previous, int pair) =>
    bool enabled = pair == 1 ? source.smt_use1 and previous.smt_use1 : pair == 2 ? source.smt_use2 and previous.smt_use2 : pair == 3 ? source.smt_use3 and previous.smt_use3 : source.smt_use4 and previous.smt_use4
    bool valid = pair == 1 ? source.smt_valid1 and previous.smt_valid1 : pair == 2 ? source.smt_valid2 and previous.smt_valid2 : pair == 3 ? source.smt_valid3 and previous.smt_valid3 : source.smt_valid4 and previous.smt_valid4
    float sourceHigh = pair == 1 ? source.smt_h1 : pair == 2 ? source.smt_h2 : pair == 3 ? source.smt_h3 : source.smt_h4
    float previousHigh = pair == 1 ? previous.smt_h1 : pair == 2 ? previous.smt_h2 : pair == 3 ? previous.smt_h3 : previous.smt_h4
    bool ready = enabled and valid and not na(sourceHigh) and not na(previousHigh)
    ready and ((source.h > previous.h and sourceHigh < previousHigh) or (source.h < previous.h and sourceHigh > previousHigh))

f_htf_pair_direction(Candle candle, int pair) =>
    float pairOpen = pair == 1 ? candle.smt_o1 : pair == 2 ? candle.smt_o2 : pair == 3 ? candle.smt_o3 : candle.smt_o4
    float pairClose = pair == 1 ? candle.smt_c1 : pair == 2 ? candle.smt_c2 : pair == 3 ? candle.smt_c3 : candle.smt_c4
    na(pairOpen) or na(pairClose) ? 0 : pairClose > pairOpen ? 1 : pairClose < pairOpen ? -1 : 0

method DrawSweepAndSMT(CandleSet candleSet) =>
    if (barstate.isrealtime or barstate.islast) and candleSet.candles.size() >= 2
        int sz = candleSet.candles.size()
        // Reset PSP barcolor paint before recomputing the live feature state.
        for resetIndex = 0 to sz - 1
            Candle resetCandle = candleSet.candles.get(resetIndex)
            color baseBodyColor = resetCandle.c > resetCandle.o ? settings.bull_body : settings.bear_body
            box.set_bgcolor(resetCandle.body, baseBodyColor)
        // Recompute GXV-style HTF SMT/PSP signals from time-aligned pair OHLC.
        for i = 0 to sz - 1
            Candle source = candleSet.candles.get(i)
            source.has_smt_bull := false
            source.has_smt_bear := false
            source.has_psp_bull := false
            source.has_psp_bear := false
            if i < sz - 1
                Candle previous = candleSet.candles.get(i + 1)
                bool bull1 = f_htf_pair_bull_smt(source, previous, 1)
                bool bull2 = f_htf_pair_bull_smt(source, previous, 2)
                bool bull3 = f_htf_pair_bull_smt(source, previous, 3)
                bool bull4 = f_htf_pair_bull_smt(source, previous, 4)
                bool bear1 = f_htf_pair_bear_smt(source, previous, 1)
                bool bear2 = f_htf_pair_bear_smt(source, previous, 2)
                bool bear3 = f_htf_pair_bear_smt(source, previous, 3)
                bool bear4 = f_htf_pair_bear_smt(source, previous, 4)
                source.has_smt_bull := bull1 or bull2 or bull3 or bull4
                source.has_smt_bear := bear1 or bear2 or bear3 or bear4
                int sourceDirection = source.c > source.o ? 1 : source.c < source.o ? -1 : 0
                source.has_psp_bull := source.has_smt_bull and sourceDirection == 1 and ((bull1 and f_htf_pair_direction(source, 1) == -1) or (bull2 and f_htf_pair_direction(source, 2) == -1) or (bull3 and f_htf_pair_direction(source, 3) == -1) or (bull4 and f_htf_pair_direction(source, 4) == -1))
                source.has_psp_bear := source.has_smt_bear and sourceDirection == -1 and ((bear1 and f_htf_pair_direction(source, 1) == 1) or (bear2 and f_htf_pair_direction(source, 2) == 1) or (bear3 and f_htf_pair_direction(source, 3) == 1) or (bear4 and f_htf_pair_direction(source, 4) == 1))
            candleSet.candles.set(i, source)

        int highSweepCount = 0
        int lowSweepCount = 0
        for i = 0 to sz - 2
            Candle B = candleSet.candles.get(i)
            Candle A = candleSet.candles.get(i + 1)
            int A_l = box.get_left(A.body)
            int A_cx = A_l + settings.width / 2
            int B_l = box.get_left(B.body)
            int B_cx = B_l + settings.width / 2
            int B_r = box.get_right(B.body)
            if not na(B.sweep_high_line)
                line.delete(B.sweep_high_line)
                B.sweep_high_line := na
            if not na(B.sweep_low_line)
                line.delete(B.sweep_low_line)
                B.sweep_low_line := na
            if not na(B.sweep_high_main_line)
                line.delete(B.sweep_high_main_line)
                B.sweep_high_main_line := na
            if not na(B.sweep_low_main_line)
                line.delete(B.sweep_low_main_line)
                B.sweep_low_main_line := na
            if not na(B.smt_high_line)
                line.delete(B.smt_high_line)
                B.smt_high_line := na
            if not na(B.smt_low_line)
                line.delete(B.smt_low_line)
                B.smt_low_line := na
            if not na(B.smt_label)
                label.delete(B.smt_label)
                B.smt_label := na
            if not na(B.psp_bull_label)
                label.delete(B.psp_bull_label)
                B.psp_bull_label := na
            if not na(B.psp_bear_label)
                label.delete(B.psp_bear_label)
                B.psp_bear_label := na
            // GXV-style confirmed sweep selection: newest valid sweep first, capped per direction.
            [highSweepValid, highSweepC3] = f_po3_sweep_valid(candleSet.candles, i, true, candleSet.settings.htf)
            [lowSweepValid, lowSweepC3] = f_po3_sweep_valid(candleSet.candles, i, false, candleSet.settings.htf)
            bool showHighSweep = highSweepValid and highSweepCount < htf_sweep_display_cap
            bool showLowSweep = lowSweepValid and lowSweepCount < htf_sweep_display_cap
            if showHighSweep
                highSweepCount += 1
            if showLowSweep
                lowSweepCount += 1
            color highSweepColor = highSweepC3 ? htf_c3_bear_color : settings.sweep_color
            color lowSweepColor = lowSweepC3 ? htf_c3_bull_color : settings.sweep_color
            int highSweepEnd = highSweepC3 and i > 0 ? box.get_right(candleSet.candles.get(i - 1).body) : B_r
            int lowSweepEnd = lowSweepC3 and i > 0 ? box.get_right(candleSet.candles.get(i - 1).body) : B_r
            if htf_sweep_pane_enabled
                if showHighSweep and line.all.size() < 490
                    B.sweep_high_line := line.new(A_cx, A.h, highSweepEnd, A.h, xloc = xloc.bar_index, color = highSweepColor, width = 1, style = htf_sweep_line_style)
                if showLowSweep and line.all.size() < 490
                    B.sweep_low_line := line.new(A_cx, A.l, lowSweepEnd, A.l, xloc = xloc.bar_index, color = lowSweepColor, width = 1, style = htf_sweep_line_style)
            if htf_sweep_main_enabled
                if showHighSweep and line.all.size() < 490
                    B.sweep_high_main_line := line.new(A.high_bar_idx, A.h, B.high_bar_idx, A.h, xloc = xloc.bar_index, color = highSweepColor, width = 1, style = htf_sweep_line_style)
                if showLowSweep and line.all.size() < 490
                    B.sweep_low_main_line := line.new(A.low_bar_idx, A.l, B.low_bar_idx, A.l, xloc = xloc.bar_index, color = lowSweepColor, width = 1, style = htf_sweep_line_style)
            bool bullAlive = B.has_smt_bull and not f_htf_smt_invalidated(candleSet.candles, i, true)
            bool bearAlive = B.has_smt_bear and not f_htf_smt_invalidated(candleSet.candles, i, false)
            if htf_smt_show and line.all.size() < 490
                if bearAlive
                    B.smt_high_line := line.new(A_cx, A.h, B_cx, B.h, xloc = xloc.bar_index, color = smt_div_line_color, style = line.style_solid, width = 1)
                if bullAlive
                    B.smt_low_line := line.new(A_cx, A.l, B_cx, B.l, xloc = xloc.bar_index, color = smt_div_line_color2, style = line.style_solid, width = 1)
            bool pspBullAlive = htf_psp_show and f_bias_direction_visible(1) and B.has_psp_bull and not f_htf_smt_invalidated(candleSet.candles, i, true)
            bool pspBearAlive = htf_psp_show and f_bias_direction_visible(-1) and B.has_psp_bear and not f_htf_smt_invalidated(candleSet.candles, i, false)
            if htf_psp_display == PSP_DISPLAY_BARCOLOR
                if pspBullAlive and not pspBearAlive
                    box.set_bgcolor(B.body, QTU.paneBodyPaint(htf_psp_bull_color, chart.bg_color))
                else if pspBearAlive and not pspBullAlive
                    box.set_bgcolor(B.body, QTU.paneBodyPaint(htf_psp_bear_color, chart.bg_color))
            else
                float pad = math.max(math.abs(B.h - B.l) * 0.06, syminfo.mintick * 12.0) * 0.65
                // Match GXV PSP marking: small, text-only direction triangles outside the HTF candle.
                color transparentLabel = color.new(color.white, 100)
                if label.all.size() < 490 and pspBullAlive
                    B.psp_bull_label := label.new(x = B_cx, y = B.l - pad, text = '▲', xloc = xloc.bar_index, yloc = yloc.price, color = transparentLabel, style = label.style_none, textcolor = htf_psp_bull_color, size = size.small)
                if label.all.size() < 490 and pspBearAlive
                    B.psp_bear_label := label.new(x = B_cx, y = B.h + pad, text = '▼', xloc = xloc.bar_index, yloc = yloc.price, color = transparentLabel, style = label.style_none, textcolor = htf_psp_bear_color, size = size.small)
            candleSet.candles.set(i, B)
        Candle oldest = candleSet.candles.get(sz - 1)
        if not na(oldest.sweep_high_line)
            line.delete(oldest.sweep_high_line)
            oldest.sweep_high_line := na
        if not na(oldest.sweep_low_line)
            line.delete(oldest.sweep_low_line)
            oldest.sweep_low_line := na
        if not na(oldest.sweep_high_main_line)
            line.delete(oldest.sweep_high_main_line)
            oldest.sweep_high_main_line := na
        if not na(oldest.sweep_low_main_line)
            line.delete(oldest.sweep_low_main_line)
            oldest.sweep_low_main_line := na
        if not na(oldest.smt_high_line)
            line.delete(oldest.smt_high_line)
            oldest.smt_high_line := na
        if not na(oldest.smt_low_line)
            line.delete(oldest.smt_low_line)
            oldest.smt_low_line := na
        if not na(oldest.smt_label)
            label.delete(oldest.smt_label)
            oldest.smt_label := na
        if not na(oldest.psp_bull_label)
            label.delete(oldest.psp_bull_label)
            oldest.psp_bull_label := na
        if not na(oldest.psp_bear_label)
            label.delete(oldest.psp_bear_label)
            oldest.psp_bear_label := na
    candleSet



// GXV-style C1/C2/C3 labels for the newest confirmed HTF sweep sequence.
// Candle arrays are newest-first: C1 is older, C2 is the sweep candle, C3 is its successor.
f_clear_htf_filter(array<line> filterLines, array<box> filterBoxes, array<label> filterLabels) =>
    while filterLines.size() > 0
        line.delete(filterLines.pop())
    while filterBoxes.size() > 0
        box.delete(filterBoxes.pop())
    while filterLabels.size() > 0
        label.delete(filterLabels.pop())
    0

f_render_htf_filter(CandleSet candleSet, int parentIndex, bool parentBull, array<line> filterLines, array<box> filterBoxes, array<label> filterLabels) =>
    if htf_filter_show and candleSet.candles.size() > 0 and not na(parentIndex)
        int firstIndex = parentIndex - 1
        int lastIndex = htf_filter_targets == 'C2 Only' ? firstIndex : math.max(0, parentIndex - 4)
        float newerHigh = na
        float newerLow = na
        for index = 0 to firstIndex
            Candle candle = candleSet.candles.get(index)
            bool ownedAlive = index == firstIndex or na(newerHigh) or (parentBull ? newerLow >= candle.l : newerHigh <= candle.h)
            bool sourceClosed = candle.o_time != time(candleSet.settings.htf)
            if index >= lastIndex and sourceClosed and ownedAlive
                bool lowerQuarter = index == firstIndex ? parentBull : not parentBull
                float level = QTU.htfFilterLevel(candle.h, candle.l, lowerQuarter, htf_filter_ratio)
                float bodyEdge = parentBull ? math.min(candle.o, candle.c) : math.max(candle.o, candle.c)
                color paint = parentBull ? htf_filter_bull_color : htf_filter_bear_color
                int right = index > 0 ? box.get_right(candleSet.candles.get(index - 1).body) : box.get_right(candle.body)
                QTU.drawHtfFilter(filterLines, filterBoxes, filterLabels, box.get_left(candle.body) + settings.width / 2, right, level, bodyEdge, paint, htf_filter_style, htf_filter_mode, htf_filter_zone, htf_filter_labels)
            newerHigh := na(newerHigh) ? candle.h : math.max(newerHigh, candle.h)
            newerLow := na(newerLow) ? candle.l : math.min(newerLow, candle.l)
    0

f_render_c123(CandleSet candleSet, array<line> filterLines, array<box> filterBoxes, array<label> filterLabels) =>
    if barstate.islast or barstate.isrealtime
        f_clear_htf_filter(filterLines, filterBoxes, filterLabels)

        if not na(candleSet.c1Label)
            label.delete(candleSet.c1Label)
            candleSet.c1Label := na
        if not na(candleSet.c2Label)
            label.delete(candleSet.c2Label)
            candleSet.c2Label := na
        if not na(candleSet.c3Label)
            label.delete(candleSet.c3Label)
            candleSet.c3Label := na

        // Show C1/C2/C3 labels for the latest confirmed sweep, even when
        // the optional 0.5/0.25 HTF filter overlay is switched off.
        if (htf_sweep_pane_enabled or htf_sweep_main_enabled) and candleSet.settings.show and candleSet.candles.size() >= 3
            int count = candleSet.candles.size()
            int foundIndex = na
            bool bullSequence = false
            bool recoveredByC3 = false

            // Newest-first array: C2 = i-1, C1 = i, C3 = i-2.
            for i = 2 to count - 1
                [highSweep, highSweepC3] = f_po3_sweep_valid(candleSet.candles, i - 1, true, candleSet.settings.htf)
                [lowSweep, lowSweepC3] = f_po3_sweep_valid(candleSet.candles, i - 1, false, candleSet.settings.htf)
                if na(foundIndex) and (highSweep or lowSweep)
                    foundIndex := i
                    bullSequence := lowSweep
                    recoveredByC3 := highSweep ? highSweepC3 : lowSweepC3

            if not na(foundIndex)
                Candle c1 = candleSet.candles.get(foundIndex)
                Candle c2 = candleSet.candles.get(foundIndex - 1)
                Candle c3 = candleSet.candles.get(foundIndex - 2)

                int x1 = box.get_left(c1.body) + settings.width / 2
                int x2 = box.get_left(c2.body) + settings.width / 2
                int x3 = box.get_left(c3.body) + settings.width / 2

                float pad1 = math.max(math.abs(c1.h - c1.l) * 0.08, syminfo.mintick * 18.0)
                float pad2 = math.max(math.abs(c2.h - c2.l) * 0.08, syminfo.mintick * 18.0)
                float pad3 = math.max(math.abs(c3.h - c3.l) * 0.08, syminfo.mintick * 18.0)

                // Match GXV: plain text only, no filled label boxes.
                // Keep C1/C2/C3 small and dark so the candle structure stays clean.
                color tagText = color.rgb(35, 35, 35)
                color transparentBg = color.new(color.white, 100)

                if bullSequence
                    candleSet.c1Label := label.new(x1, c1.l - pad1, "C1", xloc=xloc.bar_index, yloc=yloc.price, color=transparentBg, style=label.style_none, textcolor=tagText, size=size.small)
                    candleSet.c2Label := label.new(x2, c2.l - pad2, "C2", xloc=xloc.bar_index, yloc=yloc.price, color=transparentBg, style=label.style_none, textcolor=tagText, size=size.small)
                    candleSet.c3Label := label.new(x3, c3.l - pad3, "C3", xloc=xloc.bar_index, yloc=yloc.price, color=transparentBg, style=label.style_none, textcolor=tagText, size=size.small)
                else
                    candleSet.c1Label := label.new(x1, c1.h + pad1, "C1", xloc=xloc.bar_index, yloc=yloc.price, color=transparentBg, style=label.style_none, textcolor=tagText, size=size.small)
                    candleSet.c2Label := label.new(x2, c2.h + pad2, "C2", xloc=xloc.bar_index, yloc=yloc.price, color=transparentBg, style=label.style_none, textcolor=tagText, size=size.small)
                    candleSet.c3Label := label.new(x3, c3.h + pad3, "C3", xloc=xloc.bar_index, yloc=yloc.price, color=transparentBg, style=label.style_none, textcolor=tagText, size=size.small)

                // GXV sweep geometry: connect C1 extreme to C2 sweep extreme,
                // then extend the C1 level horizontally through the C3 candle.
                float c1Extreme = bullSequence ? c1.l : c1.h
                float c2Extreme = bullSequence ? c2.l : c2.h
                color sweepMarkColor = bullSequence ? htf_c3_bull_color : htf_c3_bear_color
                if line.all.size() < 488
                    line diagonal = line.new(x1, c1Extreme, x2, c2Extreme, xloc=xloc.bar_index, color=sweepMarkColor, width=1, style=line.style_solid)
                    array.push(filterLines, diagonal)
                if line.all.size() < 488
                    line levelLine = line.new(x1, c1Extreme, x3 + settings.width / 2, c1Extreme, xloc=xloc.bar_index, color=color.new(tagText, 20), width=1, style=line.style_solid)
                    array.push(filterLines, levelLine)

                // Keep the optional 0.5/0.25 measuring overlay independent from the tags.
                if htf_filter_show
                    f_render_htf_filter(candleSet, foundIndex, bullSequence, filterLines, filterBoxes, filterLabels)
    candleSet



method Monitor(CandleSet candleSet) =>
    int HTFBarTime = time(candleSet.settings.htf)
    isNewHTFCandle = ta.change(HTFBarTime) > 0
    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := nz(candleSet.settings.own_o, open)
        candle.c := nz(candleSet.settings.own_c, close)
        candle.h := nz(candleSet.settings.own_h, high)
        candle.l := nz(candleSet.settings.own_l, low)
        candle.o_time := HTFBarTime
        candle.bar_idx := bar_index
        
        candle.high_bar_idx := bar_index
        candle.low_bar_idx := bar_index
        
        bull = candle.c > candle.o
        // PSP marking is applied by DrawSweepAndSMT using GXV-style triangles or barcolor.
        color bodyColor = bull ? settings.bull_body : settings.bear_body
        color borderColor = bull ? settings.bull_border : settings.bear_border
        color wickColor = bull ? settings.bull_wick : settings.bear_wick
        
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), borderColor, 1, bgcolor = bodyColor)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = wickColor)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = wickColor)
        candle.smt_o1 := candleSet.settings.sym1_o
        candle.smt_c1 := candleSet.settings.sym1_c
        candle.smt_h1 := candleSet.settings.sym1_h
        candle.smt_l1 := candleSet.settings.sym1_l
        candle.smt_o2 := candleSet.settings.sym2_o
        candle.smt_c2 := candleSet.settings.sym2_c
        candle.smt_h2 := candleSet.settings.sym2_h
        candle.smt_l2 := candleSet.settings.sym2_l
        candle.smt_o3 := candleSet.settings.sym3_o
        candle.smt_c3 := candleSet.settings.sym3_c
        candle.smt_h3 := candleSet.settings.sym3_h
        candle.smt_l3 := candleSet.settings.sym3_l
        candle.smt_o4 := candleSet.settings.sym4_o
        candle.smt_c4 := candleSet.settings.sym4_c
        candle.smt_h4 := candleSet.settings.sym4_h
        candle.smt_l4 := candleSet.settings.sym4_l
        candle.smt_use1 := settings.psp_sym1_use and not SameInstrument(settings.psp_sym1)
        candle.smt_use2 := settings.psp_sym2_use and not SameInstrument(settings.psp_sym2)
        candle.smt_use3 := settings.psp_sym3_use and not SameInstrument(settings.psp_sym3)
        candle.smt_use4 := settings.psp_sym4_use and not SameInstrument(settings.psp_sym4)
        candle.smt_valid1 := not na(candleSet.settings.sym1_t) and candleSet.settings.sym1_t == HTFBarTime
        candle.smt_valid2 := not na(candleSet.settings.sym2_t) and candleSet.settings.sym2_t == HTFBarTime
        candle.smt_valid3 := not na(candleSet.settings.sym3_t) and candleSet.settings.sym3_t == HTFBarTime
        candle.smt_valid4 := not na(candleSet.settings.sym4_t) and candleSet.settings.sym4_t == HTFBarTime
        candleSet.candles.unshift(candle)
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
    candleSet

// NOTE: positioning (Reorder) is no longer done here. It is done in f_panelPlace()
// so panels can be ordered by timeframe instead of by slot number.
method Update(CandleSet candleSet, int offset) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        bool isLiveCandle = candle.o_time == time(candleSet.settings.htf)
        
        if isLiveCandle
            candle.h := nz(candleSet.settings.own_h, math.max(candle.h, high))
            candle.l := nz(candleSet.settings.own_l, math.min(candle.l, low))
            candle.c := nz(candleSet.settings.own_c, close)
            // Refresh pair OHLC while the HTF candle is live. This is required
            // for lookahead_off panes so the completed pair candle is retained.
            candle.smt_o1 := candleSet.settings.sym1_o
            candle.smt_c1 := candleSet.settings.sym1_c
            candle.smt_h1 := candleSet.settings.sym1_h
            candle.smt_l1 := candleSet.settings.sym1_l
            candle.smt_o2 := candleSet.settings.sym2_o
            candle.smt_c2 := candleSet.settings.sym2_c
            candle.smt_h2 := candleSet.settings.sym2_h
            candle.smt_l2 := candleSet.settings.sym2_l
            candle.smt_o3 := candleSet.settings.sym3_o
            candle.smt_c3 := candleSet.settings.sym3_c
            candle.smt_h3 := candleSet.settings.sym3_h
            candle.smt_l3 := candleSet.settings.sym3_l
            candle.smt_o4 := candleSet.settings.sym4_o
            candle.smt_c4 := candleSet.settings.sym4_c
            candle.smt_h4 := candleSet.settings.sym4_h
            candle.smt_l4 := candleSet.settings.sym4_l
            candle.smt_valid1 := not na(candleSet.settings.sym1_t) and candleSet.settings.sym1_t == time(candleSet.settings.htf)
            candle.smt_valid2 := not na(candleSet.settings.sym2_t) and candleSet.settings.sym2_t == time(candleSet.settings.htf)
            candle.smt_valid3 := not na(candleSet.settings.sym3_t) and candleSet.settings.sym3_t == time(candleSet.settings.htf)
            candle.smt_valid4 := not na(candleSet.settings.sym4_t) and candleSet.settings.sym4_t == time(candleSet.settings.htf)
            if high >= candle.h - syminfo.mintick / 2
                candle.high_bar_idx := bar_index
            if low <= candle.l + syminfo.mintick / 2
                candle.low_bar_idx := bar_index
        bull = candle.c > candle.o
        if isLiveCandle
            int HTFBarTime = time(candleSet.settings.htf)
            // Keep HTF panel body colors tied only to candle direction.
            color bodyColor = bull ? settings.bull_body : settings.bear_body
            color borderColor = bull ? settings.bull_border : settings.bear_border
            color wickColor = bull ? settings.bull_wick : settings.bear_wick
            
            box.set_bgcolor(candle.body, bodyColor)
            box.set_border_color(candle.body, borderColor)
            line.set_color(candle.wick_up, wickColor)
            line.set_color(candle.wick_down, wickColor)
            box.set_top(candle.body, candle.o)
            box.set_bottom(candle.body, candle.c)
            line.set_y1(candle.wick_up, candle.h)
            line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
            line.set_y1(candle.wick_down, candle.l)
            line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
    candleSet

// Phase 1: update data only (no positioning)
f_panelRun(CandleSet s, int offset) =>
    s.UpdateTime(offset)
    s.Monitor().Update(offset)
    true

// Phase 2: position the panel, then build its imbalances
f_panelPlace(CandleSet s, int offset) =>
    if barstate.isrealtime or barstate.islast
        if s.candles.size() > 0
            s.Reorder(offset)
    s.FindImbalance()
    true

// Sort key = timeframe length in seconds (slot index only breaks ties); na = panel not shown
f_panelKey(CandleSet s, int slot) =>
    s.settings.show and ValidTimeframe(s.settings.htf) ? timeframe.in_seconds(s.settings.htf) + slot * 0.001 : na

f_panelWidth(CandleSet s) =>
    int n = s.candles.size()
    n > 0 ? n * settings.width + (n - 1) * settings.buffer : 0

// Offset of panel `i` = padding + width of every shown panel with a shorter timeframe
f_panelOffset(int i, array<float> keys, array<int> ws) =>
    int off = settings.offset
    float mk = keys.get(i)
    for j = 0 to 2
        float kj = keys.get(j)
        if not na(kj) and kj < mk
            off += ws.get(j) + settings.htf_buffer
    off

