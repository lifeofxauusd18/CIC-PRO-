int    lineWidth    = input.int(1, 'Width', minval = 1, maxval = 5, inline = 'rs1', group = g03)
color  lvlTextColor = input.color(color.rgb(120, 123, 134), 'Text Color', inline = 'rs2', group = g03)
string lvlTextSize  = input.string(size.small, 'Text Size', options = [size.tiny, size.small, size.normal], inline = 'rs2', group = g03)

