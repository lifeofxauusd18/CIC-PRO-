bool   in_sepShow    = input.bool(true, 'HTF Separators', inline = 'sp1', group = g03)
color  in_htfSepCol  = input.color(color.gray, '', inline = 'sp1', group = g03)
bool   enableChartSeparators = input.bool(false, 'Chart Separators', inline = 'sp2', group = g03)
string sepSelection  = input.string("Auto", '', options = ["Auto", "15m", "30m", "1H", "4H", "1D", "1W"], inline = 'sp2', group = g03)
int    sepLookback   = input.int(150, 'Lookback Bars', minval = 20, maxval = 500, group = g03)
bool   sepShowLabel  = input.bool(true, 'Show Timestamp', group = g03)
color  sepColor      = input.color(color.new(#787b86, 70), 'Line / Text Color', inline = 'sp3', group = g03)
