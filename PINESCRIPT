f_addPool(array<string> keys, array<string> syms, string k, string s) =>
    array.push(keys, k)
    array.push(syms, s)

f_autoPairs() =>
    string r = syminfo.root
    string p = syminfo.prefix
    string selfKey = r == "MNQ" ? "NQ" : r == "MES" ? "ES" : r == "MYM" ? "YM" : r == "M2K" ? "RTY" : r == "MGC" ? "GC" : r
    array<string> keys = array.new_string()
    array<string> syms = array.new_string()

    bool isIdx = selfKey == "NQ" or selfKey == "ES" or selfKey == "YM" or selfKey == "RTY"
    bool isSpotMetal = str.startswith(r, "XAU") or str.startswith(r, "XAG")
    bool isFutMetal = selfKey == "GC" or selfKey == "SI" or selfKey == "PL"
    bool isFx = r == "EURUSD" or r == "GBPUSD" or r == "AUDUSD" or r == "NZDUSD"
    bool isCrypto = syminfo.type == "crypto"

    if isIdx
        f_addPool(keys, syms, "NQ", "CME_MINI:NQ1!")
        f_addPool(keys, syms, "ES", "CME_MINI:ES1!")
        f_addPool(keys, syms, "YM", "CBOT_MINI:YM1!")
        f_addPool(keys, syms, "RTY", "CME_MINI:RTY1!")
    else if isSpotMetal
        f_addPool(keys, syms, "XAUUSD", p + ":XAUUSD")
        f_addPool(keys, syms, "XAGUSD", p + ":XAGUSD")
        f_addPool(keys, syms, "XAUEUR", p + ":XAUEUR")
        f_addPool(keys, syms, "XAUGBP", p + ":XAUGBP")
    else if isFutMetal
        f_addPool(keys, syms, "GC", "COMEX:GC1!")
        f_addPool(keys, syms, "SI", "COMEX:SI1!")
        f_addPool(keys, syms, "PL", "NYMEX:PL1!")
    else if isFx
        f_addPool(keys, syms, "EURUSD", p + ":EURUSD")
        f_addPool(keys, syms, "GBPUSD", p + ":GBPUSD")
        f_addPool(keys, syms, "AUDUSD", p + ":AUDUSD")
        f_addPool(keys, syms, "NZDUSD", p + ":NZDUSD")
    else if isCrypto
        selfKey := syminfo.basecurrency
        f_addPool(keys, syms, "BTC", p + ":BTC" + syminfo.currency)
        f_addPool(keys, syms, "ETH", p + ":ETH" + syminfo.currency)
        f_addPool(keys, syms, "SOL", p + ":SOL" + syminfo.currency)
        f_addPool(keys, syms, "XRP", p + ":XRP" + syminfo.currency)

    array<string> out = array.new_string()
    if array.size(keys) > 0
        for i = 0 to array.size(keys) - 1
            if array.get(keys, i) != selfKey and array.size(out) < 4
                array.push(out, array.get(syms, i))
    int n = array.size(out)
    while array.size(out) < 4
        array.push(out, syminfo.tickerid)
    [array.get(out, 0), array.get(out, 1), array.get(out, 2), array.get(out, 3), n]

