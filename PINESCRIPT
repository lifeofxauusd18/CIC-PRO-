    switch fr_model
        '1m-15m' => '1'
        '3m-30m' => '3'
        '5m-1H'  => '5'
        '15m-4H' => '15'
        '1H-1D'  => '60'
        '4H-1W'  => '240'
        '1D-1W'  => '1D'
        'Custom' => fr_cLTF
        =>          fr_curTf()

fr_isAutoValid(int mins) => mins == 1 or mins == 3 or mins == 5 or mins == 15 or mins == 60 or mins == 240 or mins == 1440

fr_name(string t) =>
    int s = timeframe.in_seconds(t)
    s < 3600 ? str.tostring(int(s / 60)) + 'm' : s < 86400 ? str.tostring(int(s / 3600)) + 'H' : s == 86400 ? '1D' : s <= 604800 ? '1W' : '1M'

string fr_htfTf = switch fr_model
    '1m-15m' => '15'
    '3m-30m' => '30'
    '5m-1H'  => '60'
    '15m-4H' => '240'
    '1H-1D'  => '1D'
    '4H-1W'  => '1W'
    '1D-1W'  => '1W'
    'Custom' => fr_cHTF
    =>          fr_autoHTF()

bool   fr_valid   = fr_model == 'Auto' ? fr_isAutoValid(fr_tfMins(fr_curTf())) : fr_tfMins(fr_curTf()) <= fr_tfMins(fr_ltf())
string fr_htfName = fr_name(fr_htfTf)
string fr_ltfName = fr_name(fr_ltf())

[fr_curH, fr_curL, fr_curC, fr_prevH1, fr_prevL1] = request.security(syminfo.tickerid, fr_htfTf, [high[0], low[0], close[0], high[1], low[1]], lookahead = barmerge.lookahead_on)

bool fr_c2Buy  = fr_curL < fr_prevL1 and fr_curC > fr_prevL1
bool fr_c2Sell = fr_curH > fr_prevH1 and fr_curC < fr_prevH1
bool fr_periodChanged = time(fr_htfTf) != time(fr_htfTf)[1]

var float fr_cH = na
var float fr_cL = na
var int   fr_cHBar = na
var int   fr_cLBar = na
var float fr_pH = na
var float fr_pL = na
var int   fr_pHBar = na
var int   fr_pLBar = na
var bool  fr_prevBuy = false
var bool  fr_prevSell = false

if fr_periodChanged
    fr_pH := fr_cH
    fr_pL := fr_cL
    fr_pHBar := fr_cHBar
    fr_pLBar := fr_cLBar
    fr_cH := high
    fr_cL := low
    fr_cHBar := bar_index
    fr_cLBar := bar_index
    fr_prevBuy  := fr_c2Buy[1]
    fr_prevSell := fr_c2Sell[1]
else
    if high > fr_cH
        fr_cH := high
        fr_cHBar := bar_index
    if low < fr_cL
        fr_cL := low
        fr_cLBar := bar_index

fr_dirLabel(int x, float y, string txt, bool bullish) =>
    label.new(x, y, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = bullish ? label.style_label_up : label.style_label_down, color = na, textcolor = color.gray, size = size.small, text_font_family = font.family_monospace)

fr_topBot() =>
    float mid = (fr_pH + fr_pL) / 2
    [math.max(open, mid), math.min(open, mid)]

fr_drawPhase(bool isBull, bool isC4, int startBar, float top, float bot) =>
    float yDash = isBull ? bot : top
    box   bx   = fr_showT ? box.new(startBar, top, bar_index, bot, border_color = na, bgcolor = isBull ? fr_bullBox : fr_bearBox) : na
    line  dash = fr_showDashL ? line.new(startBar, yDash, bar_index, yDash, color = fr_dashCol, width = 1, style = line.style_dotted) : na
    label lbl  = na
    if isC4 and fr_showT and fr_showLbl and fr_valid
        lbl := fr_dirLabel(bar_index + 2, isBull ? bot : top, 'C4', isBull)
    [bx, dash, lbl]

fr_deleteVisuals(FrSetup s) =>
    if not na(s)
        if not na(s.c2Lbl)
            label.delete(s.c2Lbl)
        if not na(s.c3Box)
            box.delete(s.c3Box)
        if not na(s.c3Dash)
            line.delete(s.c3Dash)
        if not na(s.c4Box)
            box.delete(s.c4Box)
        if not na(s.c4Dash)
            line.delete(s.c4Dash)
        if not na(s.c4Lbl)
            label.delete(s.c4Lbl)

fr_register(FrSetup s) =>
    fr_records.push(FrRecord.new(s, bar_index))
    while fr_hist > 0 and fr_records.size() > fr_hist
        evicted = fr_records.shift()
        fr_deleteVisuals(evicted.setup)

fr_newSetup(bool isBull, float extremePrice, int extremeBar) =>
    FrSetup s = FrSetup.new(isBull, extremePrice, 1, false)
    s.c2Bar := extremeBar
    s.c2Price := extremePrice
    if fr_valid and fr_showLbl and not na(extremeBar)
        s.c2Lbl := fr_dirLabel(extremeBar, extremePrice, 'C2 (' + fr_htfName + ')', isBull)
    [top, bot] = fr_topBot()
    [bx, dash, _l] = fr_drawPhase(isBull, false, bar_index, top, bot)
    s.c3Box := bx
    s.c3Dash := dash
    fr_register(s)
    s

method advanceToC4(FrSetup s) =>
    if not na(s.c3Box)
        box.set_right(s.c3Box, bar_index)
    if not na(s.c3Dash)
        line.set_x2(s.c3Dash, bar_index)
    [top, bot] = fr_topBot()
    s.c4Top := top
    s.c4Bottom := bot
    [bx, dash, lbl] = fr_drawPhase(s.isBull, true, bar_index, top, bot)
    s.c4Box := bx
    s.c4Dash := dash
    s.c4Lbl := lbl
    s.phase := 2
    s.c4Invalid := false
    s

method finish(FrSetup s) =>
    if not na(s.c4Box)
        box.set_right(s.c4Box, bar_index)
    if not na(s.c4Dash)
        line.set_x2(s.c4Dash, bar_index)
    s.phase := 0
    s

method extendAndCheck(FrSetup s) =>
    if not na(s) and not s.dead and s.phase != 0
        box  extBox  = s.phase == 1 ? s.c3Box : s.c4Box
        line extDash = s.phase == 1 ? s.c3Dash : s.c4Dash
        if not na(extBox)
            box.set_right(extBox, bar_index)
        if not na(extDash)
            line.set_x2(extDash, bar_index)
        bool breach = s.isBull ? low < s.extreme : high > s.extreme
        if breach
            if not na(s.c3Box)
                box.delete(s.c3Box)
                s.c3Box := na
            if not na(s.c3Dash)
                line.delete(s.c3Dash)
                s.c3Dash := na
            if not na(s.c4Box)
                box.delete(s.c4Box)
                s.c4Box := na
            if not na(s.c4Dash)
                line.delete(s.c4Dash)
                s.c4Dash := na
            if not na(s.c4Lbl)
                label.delete(s.c4Lbl)
                s.c4Lbl := na
            s.dead := true
            s.phase := 0
    s

method checkC4Invalid(FrSetup s) =>
    if not na(s) and not s.dead and s.phase == 2 and not s.c4Invalid
        bool invalid = s.isBull ? close[1] < s.c4Bottom : close[1] > s.c4Top
        if invalid
            s.c4Invalid := true
            if not na(s.c4Box)
                box.delete(s.c4Box)
                s.c4Box := na
            if not na(s.c4Dash)
                line.delete(s.c4Dash)
                s.c4Dash := na
            if not na(s.c4Lbl)
                label.delete(s.c4Lbl)
                s.c4Lbl := na
    s

fr_processC2(bool trigger, bool allow, bool isBull, float extremePrice, int extremeBar, FrSetup existing) =>
    FrSetup result = existing
    if trigger and allow
        result := fr_newSetup(isBull, extremePrice, extremeBar)
    else if fr_periodChanged and not na(existing) and not existing.dead
        result := existing.phase == 1 ? existing.advanceToC4() : existing.phase == 2 ? existing.finish() : existing
    result

bool fr_buyTrig  = fr_show and fr_periodChanged and fr_prevBuy
bool fr_sellTrig = fr_show and fr_periodChanged and fr_prevSell

// ALERT FLAGS — C4 phase begins on the next HTF period after a live C3 box
bool fr_c4Buy  = false
bool fr_c4Sell = false
if fr_show and fr_periodChanged
    if not na(fr_buy) and not fr_buy.dead and fr_buy.phase == 1 and not (fr_buyTrig and fr_allowBuy)
        fr_c4Buy := true
    if not na(fr_sell) and not fr_sell.dead and fr_sell.phase == 1 and not (fr_sellTrig and fr_allowSell)
        fr_c4Sell := true

fr_buy  := fr_processC2(fr_buyTrig,  fr_allowBuy,  true,  fr_pL, fr_pLBar, fr_buy)
fr_sell := fr_processC2(fr_sellTrig, fr_allowSell, false, fr_pH, fr_pHBar, fr_sell)

if fr_show
    fr_buy  := fr_buy.extendAndCheck()
    fr_sell := fr_sell.extendAndCheck()
    fr_buy  := fr_buy.checkC4Invalid()
    fr_sell := fr_sell.checkC4Invalid()

if fr_alerts
    if fr_buyTrig and fr_allowBuy
        alert('Bullish C2 (' + fr_htfName + ') formed on ' + syminfo.ticker, alert.freq_once_per_bar)
    if fr_sellTrig and fr_allowSell
        alert('Bearish C2 (' + fr_htfName + ') formed on ' + syminfo.ticker, alert.freq_once_per_bar)

// Dashboard
fr_addTk(string base, bool use, string sym) =>
    use ? (base == '' ? syminfo.ticker(sym) : base + ' - ' + syminfo.ticker(sym)) : base

string fr_tk = fr_addTk('', rawUse1, rawSym1)
fr_tk := fr_addTk(fr_tk, rawUse2, rawSym2)
fr_tk := fr_addTk(fr_tk, rawUse3, rawSym3)
fr_tk := fr_addTk(fr_tk, rawUse4, rawSym4)
fr_tblPos(string v, string h) =>
    switch v
        'Top' =>
            switch h
                'Left'   => position.top_left
                'Center' => position.top_center
                => position.top_right
        'Middle' =>
            switch h
                'Left'   => position.middle_left
                'Center' => position.middle_center
                => position.middle_right
        =>
            switch h
                'Left'   => position.bottom_left
                'Center' => position.bottom_center
                => position.bottom_right
var table fr_tbl = table.new(fr_tblPos(fr_tblV, fr_tblH), 1, 1, bgcolor = fr_tblBg, border_width = 0)
if barstate.islast and fr_showTbl
    string frTxt = fr_valid ? '| ' + fr_htfName + ' → ' + fr_ltfName + ' |  ' + fr_tk : '⚠ Switch chart to ' + fr_ltfName + ' (fractal ' + fr_ltfName + ' → ' + fr_htfName + ')'
    table.cell(fr_tbl, 0, 0, frTxt, text_color = fr_tblText, bgcolor = fr_tblBg, text_size = size.small, text_halign = text.align_left)

// ═══════════════════════════════════════════════════════════════════════════
// ▼▼▼ SWING SMT ENGINE (chart timeframe, up to 4 correlated assets) ▼▼▼
// Bullish text = above the line, Bearish text = below the line
// ═══════════════════════════════════════════════════════════════════════════

float smtTol = smtTolTicks * syminfo.mintick

[smtB1h, smtB1l] = request.security(settings.psp_sym1, timeframe.period, [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[smtB2h, smtB2l] = request.security(settings.psp_sym2, timeframe.period, [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[smtB3h, smtB3l] = request.security(settings.psp_sym3, timeframe.period, [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
[smtB4h, smtB4l] = request.security(settings.psp_sym4, timeframe.period, [high, low], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

array<float>  smtBHi   = array.from(smtB1h[1], smtB2h[1], smtB3h[1], smtB4h[1])
array<float>  smtBLo   = array.from(smtB1l[1], smtB2l[1], smtB3l[1], smtB4l[1])
array<bool>   smtUse   = array.from(settings.psp_sym1_use, settings.psp_sym2_use, settings.psp_sym3_use, settings.psp_sym4_use)
array<bool>   smtInvA  = array.from(smtInv1, smtInv2, smtInv3, smtInv4)
array<string> smtNames = array.from(ShortTicker(settings.psp_sym1), ShortTicker(settings.psp_sym2), ShortTicker(settings.psp_sym3), ShortTicker(settings.psp_sym4))

var float smtPrevHiA    = na
var int   smtPrevHiBarA = na
var float smtPrevLoA    = na
var int   smtPrevLoBarA = na
var array<float> smtPrevHiB = array.new_float(4, na)
var array<float> smtPrevLoB = array.new_float(4, na)
var array<line>  smtLines   = array.new_line()
var array<label> smtLabels  = array.new_label()

bool bearSMT = false
bool bullSMT = false

if smtEnable and smtSwingOn and getSMTEnabled(timeframe.period) and barstate.isconfirmed
    bool swingHi = high[1] > high[0] and high[1] > high[2]
    bool swingLo = low[1]  < low[0]  and low[1]  < low[2]

    // ── Swing HIGH → bearish SMT (text below the line) ──
    if swingHi
        float aHi    = high[1]
        int   aHiBar = bar_index - 1
        if not na(smtPrevHiA) and aHi > smtPrevHiA + smtTol
            int divCnt = 0
            string divNames = ""
            for k = 0 to 3
                float bNow  = smtBHi.get(k)
                float bPrev = smtPrevHiB.get(k)
                if smtUse.get(k) and not na(bNow) and not na(bPrev)
                    bool bMadeHigh = bNow > bPrev
                    bool diverges = smtInvA.get(k) ? bMadeHigh : not bMadeHigh
                    if diverges
                        divCnt += 1
                        divNames += (divNames == "" ? "" : " ") + smtNames.get(k)
            if divCnt >= smtMinAssets
                bearSMT := true
                line ln = line.new(smtPrevHiBarA, smtPrevHiA, aHiBar, aHi, color = smtBearCol, style = LineStyle(div_line_style), width = math.max(div_line_width, 1))
                label lb = label.new(int(math.round((smtPrevHiBarA + aHiBar) / 2)), (smtPrevHiA + aHi) / 2, "SMT " + HTFName(timeframe.period) + (smt_label_show ? " · " + divNames : ""), yloc = yloc.price, style = label.style_label_up, color = color_transparent, textcolor = smt_text_col, size = size.tiny)
                array.push(smtLines, ln)
                array.push(smtLabels, lb)
        smtPrevHiA := aHi
        smtPrevHiBarA := aHiBar
        for k = 0 to 3
            if not na(smtBHi.get(k))
                smtPrevHiB.set(k, smtBHi.get(k))

    // ── Swing LOW → bullish SMT (text above the line) ──
    if swingLo
        float aLo    = low[1]
        int   aLoBar = bar_index - 1
        if not na(smtPrevLoA) and aLo < smtPrevLoA - smtTol
            int divCntL = 0
            string divNamesL = ""
            for k = 0 to 3
                float bNowL  = smtBLo.get(k)
                float bPrevL = smtPrevLoB.get(k)
                if smtUse.get(k) and not na(bNowL) and not na(bPrevL)
                    bool bMadeLow = bNowL < bPrevL
                    bool divergesL = smtInvA.get(k) ? bMadeLow : not bMadeLow
                    if divergesL
                        divCntL += 1
                        divNamesL += (divNamesL == "" ? "" : " ") + smtNames.get(k)
            if divCntL >= smtMinAssets
                bullSMT := true
                line lnL = line.new(smtPrevLoBarA, smtPrevLoA, aLoBar, aLo, color = smtBullCol, style = LineStyle(div_line_style), width = math.max(div_line_width, 1))
                label lbL = label.new(int(math.round((smtPrevLoBarA + aLoBar) / 2)), (smtPrevLoA + aLo) / 2, "SMT " + HTFName(timeframe.period) + (smt_label_show ? " · " + divNamesL : ""), yloc = yloc.price, style = label.style_label_down, color = color_transparent, textcolor = smt_text_col, size = size.tiny)
                array.push(smtLines, lnL)
                array.push(smtLabels, lbL)
        smtPrevLoA := aLo
        smtPrevLoBarA := aLoBar
        for k = 0 to 3
            if not na(smtBLo.get(k))
                smtPrevLoB.set(k, smtBLo.get(k))

    while array.size(smtLines) > smtMax
        line.delete(array.shift(smtLines))
        label.delete(array.shift(smtLabels))

// ═══════════════════════════════════════════════════════════════════════════
// ▼▼▼ SSMT ENGINE (two consecutive CLOSED HTF candles) ▼▼▼
// Chart asset takes the previous closed candle's high/low by more than the
// tolerance; enough correlated assets fail to confirm (inverse-aware).
// Evaluated ONLY on the first bar of the new HTF candle -> no repaint.
// Reuses the swing-SMT security calls above (0 extra request.security).
// Bearish text below the line, bullish text above (same as swing SMT).
// ═══════════════════════════════════════════════════════════════════════════

var array<line>  ssmtLines  = array.new_line()
var array<label> ssmtLabels = array.new_label()

array<float> ssmtBH = array.from(smtB1h, smtB2h, smtB3h, smtB4h)
array<float> ssmtBL = array.from(smtB1l, smtB2l, smtB3l, smtB4l)
array<bool> ssmtInvA = array.from(ssmtInv1, ssmtInv2, ssmtInv3, ssmtInv4)
float ssmtTol = ssmtTolTicks * syminfo.mintick

ssmtScan(string tf, string tfTxt, bool enabled) =>
    // chart asset registers: P = previous closed, C = last closed, R = forming
    var float aPH = na
    var float aPL = na
    var int   aPHb = na
    var int   aPLb = na
    var float aCH = na
    var float aCL = na
    var int   aCHb = na
    var int   aCLb = na
    var float aRH = na
    var float aRL = na
    var int   aRHb = na
    var int   aRLb = na
    var int   rT = na
    var array<float> bPH = array.new_float(4, na)
    var array<float> bPL = array.new_float(4, na)
    var array<float> bCH = array.new_float(4, na)
    var array<float> bCL = array.new_float(4, na)
    var array<float> bRH = array.new_float(4, na)
    var array<float> bRL = array.new_float(4, na)

    bool bullOut = false
    bool bearOut = false
    int htfT = time(tf)
    bool valid = enabled and not na(htfT) and timeframe.in_seconds(tf) > timeframe.in_seconds()

    if valid
        bool isNew = na(rT) or htfT != rT
        if isNew
            // shift registers: last closed becomes previous, forming becomes last closed
            aPH := aCH
            aPL := aCL
            aPHb := aCHb
            aPLb := aCLb
            aCH := aRH
            aCL := aRL
            aCHb := aRHb
            aCLb := aRLb
            for k = 0 to 3
                bPH.set(k, bCH.get(k))
                bPL.set(k, bCL.get(k))
                bCH.set(k, bRH.get(k))
                bCL.set(k, bRL.get(k))
                bRH.set(k, ssmtBH.get(k))
                bRL.set(k, ssmtBL.get(k))
            aRH := high
            aRL := low
            aRHb := bar_index
            aRLb := bar_index
            rT := htfT
        else
            if high > aRH
                aRH := high
                aRHb := bar_index
            if low < aRL
                aRL := low
                aRLb := bar_index
            for k = 0 to 3
                float bh = ssmtBH.get(k)
                float bl = ssmtBL.get(k)
                if not na(bh)
                    bRH.set(k, na(bRH.get(k)) ? bh : math.max(bRH.get(k), bh))
                if not na(bl)
                    bRL.set(k, na(bRL.get(k)) ? bl : math.min(bRL.get(k), bl))

        // detect only on the boundary bar (previous HTF candle just closed)
        if isNew and barstate.isconfirmed and not na(aPH) and not na(aCH) and not na(aPL) and not na(aCL)
            // ── bearish: chart asset took the previous high ──
            if aCH > aPH + ssmtTol
                int ssCnt = 0
                string ssNm = ""
                for k = 0 to 3
                    float bc = bCH.get(k)
                    float bp = bPH.get(k)
                    if smtUse.get(k) and not na(bc) and not na(bp)
                        bool made = bc > bp
                        bool dv = ssmtInvA.get(k) ? made : not made
                        if dv
                            ssCnt += 1
                            ssNm += (ssNm == "" ? "" : " ") + smtNames.get(k)
                if ssCnt >= ssmtMinAssets
                    bearOut := true
                    line ssLn = line.new(aPHb, aPH, aCHb, aCH, color = ssmtBearCol, style = ssmt_line_style == "Solid" ? line.style_solid : ssmt_line_style == "Dashed" ? line.style_dashed : line.style_dotted, width = ssmt_line_width)
                    label ssLb = label.new(int(math.round((aPHb + aCHb) / 2)), (aPH + aCH) / 2, "SSMT " + tfTxt + (ssmt_label_show ? " · " + ssNm : ""), yloc = yloc.price, style = label.style_label_up, color = color_transparent, textcolor = ssmt_text_col, size = size.small)
                    array.push(ssmtLines, ssLn)
                    array.push(ssmtLabels, ssLb)
            // ── bullish: chart asset took the previous low ──
            if aCL < aPL - ssmtTol
                int ssCntL = 0
                string ssNmL = ""
                for k = 0 to 3
                    float bcL = bCL.get(k)
                    float bpL = bPL.get(k)
                    if smtUse.get(k) and not na(bcL) and not na(bpL)
                        bool madeL = bcL < bpL
                        bool dvL = ssmtInvA.get(k) ? madeL : not madeL
                        if dvL
                            ssCntL += 1
                            ssNmL += (ssNmL == "" ? "" : " ") + smtNames.get(k)
                if ssCntL >= ssmtMinAssets
                    bullOut := true
                    line ssLnL = line.new(aPLb, aPL, aCLb, aCL, color = ssmtBullCol, style = ssmt_line_style == "Solid" ? line.style_solid : ssmt_line_style == "Dashed" ? line.style_dashed : line.style_dotted, width = ssmt_line_width)
                    label ssLbL = label.new(int(math.round((aPLb + aCLb) / 2)), (aPL + aCL) / 2, "SSMT " + tfTxt + (ssmt_label_show ? " · " + ssNmL : ""), yloc = yloc.price, style = label.style_label_down, color = color_transparent, textcolor = ssmt_text_col, size = size.small)
                    array.push(ssmtLines, ssLnL)
                    array.push(ssmtLabels, ssLbL)
            while array.size(ssmtLines) > ssmtMax
                line.delete(array.shift(ssmtLines))
                label.delete(array.shift(ssmtLabels))
    [bullOut, bearOut]

[ssBull15, ssBear15] = ssmtScan("15",  "15m", ssmtOn and ssmt_en_15m)
[ssBull30, ssBear30] = ssmtScan("30",  "30m", ssmtOn and ssmt_en_30m)
[ssBull1h, ssBear1h] = ssmtScan("60",  "1H",  ssmtOn and ssmt_en_1h)
[ssBull90, ssBear90] = ssmtScan("90",  "90m", ssmtOn and ssmt_en_90m)
[ssBull4h, ssBear4h] = ssmtScan("240", "4H",  ssmtOn and ssmt_en_4h)
[ssBull6h, ssBear6h] = ssmtScan("360", "6H",  ssmtOn and ssmt_en_6h)
[ssBull7h, ssBear7h] = ssmtScan("420", "7H",  ssmtOn and ssmt_en_7h)
[ssBull1d, ssBear1d] = ssmtScan("D",   "1D",  ssmtOn and ssmt_en_1d)
[ssBull1w, ssBear1w] = ssmtScan("W",   "1W",  ssmtOn and ssmt_en_1w)

bool bullSSMT = ssBull15 or ssBull30 or ssBull1h or ssBull90 or ssBull4h or ssBull6h or ssBull7h or ssBull1d or ssBull1w
bool bearSSMT = ssBear15 or ssBear30 or ssBear1h or ssBear90 or ssBear4h or ssBear6h or ssBear7h or ssBear1d or ssBear1w

// ═══════════════════════════════════════════════════════════════════════════
// ▼▼▼ FVG ENGINE (30m / 1H / 4H, separate settings per timeframe) ▼▼▼
// ═══════════════════════════════════════════════════════════════════════════

var array<box>   fvgBoxes = array.new_box()
var array<line>  fvgCEs   = array.new_line()
var array<float> fvgTop   = array.new_float()
var array<float> fvgBot   = array.new_float()
var array<int>   fvgDir   = array.new_int()
var array<int>   fvgBorn  = array.new_int()
var array<int>   fvgSec   = array.new_int()
var array<bool>  fvgDone  = array.new_bool()

bool bullFVG = false
bool bearFVG = false
bool fvgMitHit = false
int fvgSC = timeframe.in_seconds()
int fvgBarMs = fvgSC * 1000
// Previous confirmed daily ATR, shared by 30m / 1H / 4H FVGs.
float fvgDailyAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)

string fvgTfA = "30"
string fvgTfB = "60"
string fvgTfC = "240"
int fvgSA = 1800
int fvgSB = 3600
int fvgSC3 = 14400

bool fvgClA = not na(time_close(fvgTfA)) and time_close(fvgTfA) == time_close
bool fvgClB = not na(time_close(fvgTfB)) and time_close(fvgTfB) == time_close
bool fvgClC = not na(time_close(fvgTfC)) and time_close(fvgTfC) == time_close

// per-timeframe setting pickers
fvgClosing(int sec) =>
    sec == fvgSA ? fvgClA : sec == fvgSB ? fvgClB : fvgClC

fvgTfLabel(int sec) =>
    sec == 1800 ? "30m" : sec == 3600 ? "1H" : "4H"

fvgBullColOf(int sec) =>
    sec == 1800 ? fvgBull30 : sec == 3600 ? fvgBull60 : fvgBull240

fvgBearColOf(int sec) =>
    sec == 1800 ? fvgBear30 : sec == 3600 ? fvgBear60 : fvgBear240

fvgMitOf(int sec) =>
    sec == 1800 ? fvgMit30 : sec == 3600 ? fvgMit60 : fvgMit240

fvgKillOf(int sec) =>
    sec == 1800 ? fvgKill30 : sec == 3600 ? fvgKill60 : fvgKill240

fvgMinOf(int sec) =>
    (sec == 1800 ? fvgMin30 : sec == 3600 ? fvgMin60 : fvgMin240) * syminfo.mintick

fvgLblOf(int sec) =>
    sec == 1800 ? fvgLbl30 : sec == 3600 ? fvgLbl60 : fvgLbl240

fvgEnabledOf(int sec) =>
    sec == 1800 ? fvgShow30 : sec == 3600 ? fvgShow60 : fvgShow240

fvgIsNear(float gTop, float gBot) =>
    float dist = close > gTop ? close - gTop : close < gBot ? gBot - close : 0.0
    not fvgAtrVisible or fvgMaxDistAtr <= 0 or na(fvgDailyAtr) or dist <= fvgMaxDistAtr * fvgDailyAtr

fvgDistOf(float gTop, float gBot) =>
    close > gTop ? close - gTop : close < gBot ? gBot - close : 0.0

fvgOverlaps(bool isBull, float gTop, float gBot, int sec) =>
    bool hit = false
    int n = array.size(fvgBoxes)
    if n > 0
        for i = 0 to n - 1
            if not array.get(fvgDone, i) and array.get(fvgDir, i) == (isBull ? 1 : -1) and array.get(fvgSec, i) >= sec and gBot < array.get(fvgTop, i) and gTop > array.get(fvgBot, i)
                hit := true
    hit

fvgAdd(bool isBull, float gTop, float gBot, int leftTime, int sec) =>
    bool added = false
    bool bigEnough = gTop > gBot and (gTop - gBot) >= math.max(fvgMinOf(sec), fvgMinGapAtr * nz(fvgDailyAtr, 0.0))
    bool dup = fvgNoOverlap and fvgOverlaps(isBull, gTop, gBot, sec)
    if bigEnough and not dup and not na(leftTime)
        color c = isBull ? fvgBullColOf(sec) : fvgBearColOf(sec)
        bool visibleNow = fvgOn and fvgEnabledOf(sec) and fvgIsNear(gTop, gBot)
        int rightT = time + fvgExt * fvgBarMs
        float mid = (gTop + gBot) / 2
        box bx = box.new(leftTime, gTop, rightT, gBot, xloc = xloc.bar_time,
             bgcolor = visibleNow ? c : color(na), border_color = visibleNow ? color.new(c, fvgBorderTr) : color(na), border_width = 1,
             text = fvgLblOf(sec) ? "FVG (" + fvgTfLabel(sec) + ")" : "",
             text_halign = text.align_right, text_valign = text.align_center,
             text_size = fvgLblSize, text_color = visibleNow ? color.new(c, 0) : color(na))
        line ce = fvgCE ? line.new(leftTime, mid, rightT, mid, xloc = xloc.bar_time, color = visibleNow ? color.new(c, 40) : color(na), style = line.style_dotted, width = 1) : na
        array.push(fvgBoxes, bx)
        array.push(fvgCEs, ce)
        array.push(fvgTop, gTop)
        array.push(fvgBot, gBot)
        array.push(fvgDir, isBull ? 1 : -1)
        array.push(fvgBorn, bar_index)
        array.push(fvgSec, sec)
        array.push(fvgDone, false)
        while array.size(fvgBoxes) > fvgMax
            box.delete(array.shift(fvgBoxes))
            line.delete(array.shift(fvgCEs))
            array.shift(fvgTop)
            array.shift(fvgBot)
            array.shift(fvgDir)
            array.shift(fvgBorn)
            array.shift(fvgSec)
            array.shift(fvgDone)
        added := true
    added

fvgScan(string tf, int tfSec, bool enabled) =>
    var float aH = na
    var float aL = na
    var int   aT = na
    var float bH = na
    var float bL = na
    var int   bT = na
    var float dH = na
    var float dL = na
    var int   dT = na
    bool bullAdd = false
    bool bearAdd = false
    int htfOpen = time(tf)
    if not na(htfOpen)
        if na(dT) or htfOpen != dT
            aH := bH
            aL := bL
            aT := bT
            bH := dH
            bL := dL
            bT := dT
            dH := high
            dL := low
            dT := htfOpen
        else
            dH := math.max(dH, high)
            dL := math.min(dL, low)
    bool lastBar = not na(htfOpen) and time_close(tf) == time_close
    if enabled and tfSec > fvgSC and lastBar and barstate.isconfirmed
        if dL > aH
            bullAdd := fvgAdd(true, dL, aH, aT, tfSec)
        if dH < aL
            bearAdd := fvgAdd(false, aL, dH, aT, tfSec)
    [bullAdd, bearAdd]

// ── Mitigation (each gap uses its own timeframe's rule) ──
if fvgOn and barstate.isconfirmed
    int idx = array.size(fvgBoxes) - 1
    while idx >= 0
        float gTop = array.get(fvgTop, idx)
        float gBot = array.get(fvgBot, idx)
        bool  isBullGap = array.get(fvgDir, idx) == 1
        int   gSec = array.get(fvgSec, idx)
        string mitRule = fvgMitOf(gSec)
        bool  drop = false
        if array.get(fvgDone, idx)
            drop := isBullGap ? close < gBot : close > gTop
        else if bar_index > array.get(fvgBorn, idx)
            bool mit = false
            if mitRule == FVG_MIT_WICK
                mit := isBullGap ? low <= gTop : high >= gBot
            else if mitRule == FVG_MIT_FULL
                mit := isBullGap ? low <= gBot : high >= gTop
            else
                mit := fvgClosing(gSec) and (isBullGap ? close <= gTop : close >= gBot)
            if mit
                fvgMitHit := true
                if fvgKillOf(gSec) or not fvgFreezeMit
                    drop := true
                else
                    box  gb = array.get(fvgBoxes, idx)
                    line gl = array.get(fvgCEs, idx)
                    box.set_right(gb, time)
                    box.set_bgcolor(gb, fvgMitCol)
                    box.set_border_color(gb, color.new(color.gray, 85))
                    box.set_text_color(gb, color.new(color.gray, 60))
                    if not na(gl)
                        line.set_x2(gl, time)
                        line.set_color(gl, color.new(color.gray, 70))
                    array.set(fvgDone, idx, true)
        if drop
            box.delete(array.get(fvgBoxes, idx))
            line gd = array.get(fvgCEs, idx)
            if not na(gd)
                line.delete(gd)
            array.remove(fvgBoxes, idx)
            array.remove(fvgCEs, idx)
            array.remove(fvgTop, idx)
            array.remove(fvgBot, idx)
            array.remove(fvgDir, idx)
            array.remove(fvgBorn, idx)
            array.remove(fvgSec, idx)
            array.remove(fvgDone, idx)
        idx -= 1

// ── Per-timeframe scans (each has its own on/off button) ──
[fvgBullA, fvgBearA] = fvgScan(fvgTfA, fvgSA, fvgOn and fvgShow30)
[fvgBullB, fvgBearB] = fvgScan(fvgTfB, fvgSB, fvgOn and fvgShow60)
[fvgBullC, fvgBearC] = fvgScan(fvgTfC, fvgSC3, fvgOn and fvgShow240)
bullFVG := fvgBullA or fvgBullB or fvgBullC
bearFVG := fvgBearA or fvgBearB or fvgBearC

// ── Refresh FVG visuals on every last-bar execution. ──
// All timeframes use one daily ATR proximity filter; hidden zones remain tracked.
// Tapped FVGs keep their frozen right boundary and are removed on full break.
if barstate.islast
    int nG = array.size(fvgBoxes)
    if nG > 0
        for i = 0 to nG - 1
            box gb = array.get(fvgBoxes, i)
            line gl = array.get(fvgCEs, i)
            int sec = array.get(fvgSec, i)
            bool done = array.get(fvgDone, i)
            bool isBull = array.get(fvgDir, i) == 1
            float top = array.get(fvgTop, i)
            float bot = array.get(fvgBot, i)
            bool vis = fvgOn and fvgEnabledOf(sec) and fvgIsNear(top, bot)
            // hide a gap that sits inside an active higher-TF gap (same direction)
            if vis and not done and fvgHideNested
                for j = 0 to nG - 1
                    if j != i and not array.get(fvgDone, j) and array.get(fvgDir, j) == array.get(fvgDir, i) and array.get(fvgSec, j) > sec and fvgEnabledOf(array.get(fvgSec, j))
                        if bot < array.get(fvgTop, j) and top > array.get(fvgBot, j)
                            vis := false
                            break
            // keep only the N nearest unmitigated gaps
            if vis and not done and fvgMaxVisible > 0
                float myDist = fvgDistOf(top, bot)
                int closer = 0
                for j = 0 to nG - 1
                    if j != i and not array.get(fvgDone, j) and fvgEnabledOf(array.get(fvgSec, j))
                        if fvgDistOf(array.get(fvgTop, j), array.get(fvgBot, j)) < myDist
                            closer += 1
                if closer >= fvgMaxVisible
                    vis := false
            color baseCol = isBull ? fvgBullColOf(sec) : fvgBearColOf(sec)
            color boxCol = done ? fvgMitCol : baseCol
            box.set_bgcolor(gb, vis ? boxCol : color(na))
            box.set_border_color(gb, vis ? (done ? color.new(color.gray, 85) : color.new(baseCol, fvgBorderTr)) : color(na))
            box.set_text_color(gb, vis ? (done ? color.new(color.gray, 60) : color.new(baseCol, 0)) : color(na))
            if not done
                box.set_right(gb, time + fvgExt * fvgBarMs)
            if not na(gl)
                line.set_color(gl, vis ? (done ? color.new(color.gray, 70) : color.new(baseCol, 40)) : color(na))
                if not done
                    line.set_x2(gl, time + fvgExt * fvgBarMs)

