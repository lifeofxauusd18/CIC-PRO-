bool newXC2 = validSignal and (na(lastC2) or c2Time != lastC2)

if newXC2
    lastC2 := c2Time

    int startTime = c1Time

    if supported
        float bestDifference = 1e20
        int bestTime = na

        for i = 0 to 120
            if not na(time[i]) and time[i] >= c1Time and time[i] < c2Time
                float extreme = bull ? low[i] : high[i]
                float difference = math.abs(extreme - level)

                if difference < bestDifference
                    bestDifference := difference
                    bestTime := time[i]

        if not na(bestTime)
            startTime := bestTime

    line newLine = line.new(startTime, level, c2End, level, xloc=xloc.bar_time, color=rcColor, width=rcWidth, style=rcStyle)

