method CandleSetHigh(array<Candle> candles, float h) =>
    _h = h
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c = array.get(candles, i)
            if c.h > _h
                _h := c.h
    _h

method CandleSetLow(array<Candle> candles, float l) =>
    _l = l
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c = array.get(candles, i)
            if c.l < _l
                _l := c.l
    _l

method CandlesHigh(CandleSet htf1, CandleSet htf2, CandleSet htf3, array<Candle> candles) =>
    h = 0.0
    int cnt = 0
    int last = htf1.HTFEnabled(htf2, htf3)
    if htf1.settings.show and ValidTimeframe(htf1.settings.htf)
        h := htf1.candles.CandleSetHigh(h)
        cnt += 1
    if htf2.settings.show and ValidTimeframe(htf2.settings.htf) and cnt < last
        h := htf2.candles.CandleSetHigh(h)
        cnt += 1
    if htf3.settings.show and ValidTimeframe(htf3.settings.htf) and cnt < last
        h := htf3.candles.CandleSetHigh(h)
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c = array.get(candles, i)
            if c.h > h
                h := c.h
    h

method CandlesLow(CandleSet htf1, CandleSet htf2, CandleSet htf3, array<Candle> candles, float h) =>
    l = h
    int cnt = 0
    int last = htf1.HTFEnabled(htf2, htf3)
    if htf1.settings.show and ValidTimeframe(htf1.settings.htf)
        l := htf1.candles.CandleSetLow(l)
        cnt += 1
    if htf2.settings.show and ValidTimeframe(htf2.settings.htf) and cnt < last
        l := htf2.candles.CandleSetLow(l)
        cnt += 1
    if htf3.settings.show and ValidTimeframe(htf3.settings.htf) and cnt < last
