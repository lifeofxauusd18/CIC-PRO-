f_detect() =>
    bool bullSweep = low[1] < low[2]
    bool bearSweep = high[1] > high[2]

    bool bullBack = close[1] > low[2]
    bool bearBack = close[1] < high[2]

    bool bullColors = close[2] < open[2] and close[1] > open[1]
    bool bearColors = close[2] > open[2] and close[1] < open[1]

    bool bull = bullSweep and (not requireCloseBack or bullBack) and (not requireColors or bullColors)
    bool bear = bearSweep and (not requireCloseBack or bearBack) and (not requireColors or bearColors)

    if bull and bear
        bull := close[1] >= open[1]
        bear := not bull

    int direction = bull ? 1 : bear ? -1 : 0
    float level = bull ? low[2] : bear ? high[2] : na

    [direction, level, time[2], time[1], time_close[1]]


// ==========================================
// 6. LATEST CONFIRMED EVENT FUNCTION
// ==========================================
f_latest() =>
    [direction, level, c1Time, c2Time, c2End] = f_detect()

    int latestDirection = nz(ta.valuewhen(direction != 0, direction, 0), 0)
    int latestTime = nz(ta.valuewhen(direction != 0, c2Time, 0), 0)

    [latestDirection, latestTime]

