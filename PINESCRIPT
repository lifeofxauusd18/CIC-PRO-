// ═══════════════════════════════════════════════════════════════════════════
// ▼▼▼ FVG MTF MODULE v3 — FREEZE MODE FOLLOWS ATR DISTANCE ▼▼▼
// ═══════════════════════════════════════════════════════════════════════════

string FVG_MIT_CLOSE = "Close Inside / Beyond"
string FVG_MIT_WICK  = "Any Wick Touch"
string FVG_MIT_FULL  = "Full Fill"
string FVG_MD_DELETE = "Delete"
string FVG_MD_FADE   = "Freeze"

string fvg_gVis = "FVG: Visibility"
string fvg_gTf  = "FVG: Timeframes"
string fvg_gCln = "FVG: Declutter"
string fvg_gCol = "FVG: Colors"
string fvg_gLbl = "FVG: Label"

// ───────────── INPUTS ─────────────
bool fvg_showAll = input.bool(true, "Show FVGs (master hide / unhide)", group = fvg_gVis)

bool   fvg_show1 = input.bool(false, "Show", inline = "fvt1", group = fvg_gTf)
string fvg_tf1   = input.timeframe("30",  "FVG TF 1", inline = "fvt1", group = fvg_gTf)
bool   fvg_show2 = input.bool(true, "Show", inline = "fvt2", group = fvg_gTf)
string fvg_tf2   = input.timeframe("60",  "FVG TF 2", inline = "fvt2", group = fvg_gTf)
bool   fvg_show3 = input.bool(true, "Show", inline = "fvt3", group = fvg_gTf)
string fvg_tf3   = input.timeframe("240", "FVG TF 3", inline = "fvt3", group = fvg_gTf)

string fvg_mitMode = input.string(FVG_MIT_CLOSE, "Mitigation Rule", options = [FVG_MIT_CLOSE, FVG_MIT_WICK, FVG_MIT_FULL], group = fvg_gTf,
     tooltip = "Close Inside / Beyond: a chart candle CLOSES inside the gap, or closes through it (judged at candle close by definition).\nAny Wick Touch: any wick enters the gap.\nFull Fill: price trades through the entire gap (wick-based).")
bool fvg_liveMit = input.bool(true, "Live mitigation (wick / full-fill react on every tick)", group = fvg_gTf,
     tooltip = "ON: with Any Wick Touch or Full Fill, a gap is hidden/frozen the instant price touches it, not when the candle closes. Has no effect on the Close rule.")
string fvg_mitDisplay = input.string(FVG_MD_DELETE, "Mitigated FVGs", options = [FVG_MD_DELETE, FVG_MD_FADE], group = fvg_gTf,
     tooltip = "Delete: mitigated gaps disappear.\nFreeze: they stay as a frozen box. They follow the same ATR distance and timeframe toggles as normal FVGs.")
int fvg_extBars = input.int(15, "Extension Bars (chart bars ahead of price)", minval = 1, maxval = 400, group = fvg_gTf)
int fvg_maxFvg  = input.int(20, "Max Tracked FVGs (all TFs combined)", minval = 1, maxval = 250, group = fvg_gTf)

float fvg_maxDistAtr = input.float(1.5, "Max distance from price (x daily ATR, 0 = off)", minval = 0.0, step = 0.25, group = fvg_gCln,
     tooltip = "FVGs (including frozen ones) farther than this from the current close are hidden. They reappear when price gets close.")
float fvg_minGapAtr  = input.float(0.02, "Min gap size (x daily ATR, 0 = off)", minval = 0.0, step = 0.01, group = fvg_gCln,
     tooltip = "Ignore tiny gaps smaller than this.")
bool  fvg_noOverlap  = input.bool(true, "Skip FVGs overlapping an existing one (same direction, same/higher TF)", group = fvg_gCln)

color fvg_bullCol = input.color(color.new(color.teal, 85), "Bullish FVG", group = fvg_gCol)
color fvg_bearCol = input.color(color.new(color.red, 85),  "Bearish FVG", group = fvg_gCol)
color fvg_mitCol  = input.color(color.new(color.gray, 92), "Mitigated FVG (freeze mode)", group = fvg_gCol)
int   fvg_borderTr = input.int(70, "Border Transparency", minval = 0, maxval = 100, group = fvg_gCol)

bool   fvg_showLabel = input.bool(true, "Show FVG Label", group = fvg_gLbl)
string fvg_lblSize   = input.string(size.small, "Label Size", options = [size.tiny, size.small, size.normal], group = fvg_gLbl)
int    fvg_lblTransp = input.int(0, "Label Transparency (0 = solid)", minval = 0, maxval = 100, group = fvg_gLbl)

// ───────────── STATE ─────────────
var array<box>   fvg_box  = array.new_box()
var array<float> fvg_top  = array.new_float()
var array<float> fvg_bot  = array.new_float()
var array<int>   fvg_bar  = array.new_int()
var array<bool>  fvg_bull = array.new_bool()
var array<int>   fvg_sec  = array.new_int()

// Frozen (mitigated) FVGs are kept here so they can follow the ATR distance rule
var array<box>   fz_box = array.new_box()
var array<float> fz_top = array.new_float()
var array<float> fz_bot = array.new_float()
var array<int>   fz_sec = array.new_int()

int fvg_barMs = timeframe.in_seconds() * 1000
int fvg_s1 = timeframe.in_seconds(fvg_tf1)
int fvg_s2 = timeframe.in_seconds(fvg_tf2)
int fvg_s3 = timeframe.in_seconds(fvg_tf3)

// true only on the chart bar that closes a candle of that FVG timeframe
bool fvg_cl1 = not na(time_close(fvg_tf1)) and time_close(fvg_tf1) == time_close
bool fvg_cl2 = not na(time_close(fvg_tf2)) and time_close(fvg_tf2) == time_close
bool fvg_cl3 = not na(time_close(fvg_tf3)) and time_close(fvg_tf3) == time_close

fvg_closing(int sec) =>
    sec == fvg_s1 ? fvg_cl1 : sec == fvg_s2 ? fvg_cl2 : fvg_cl3

float fvg_dAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)

// ───────────── HELPERS ─────────────
fvg_tfLabel(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string s = ""
    if sec < 3600
        s := str.tostring(int(sec / 60)) + "m"
    else if sec < 86400
        s := str.tostring(int(sec / 3600)) + "H"
    else if sec >= 86400 * 28
        s := "M"
    else if sec >= 604800
        s := "W"
    else
        s := "D"
    s

fvg_tfOn(int sec) =>
    bool on = true
    if sec == fvg_s1
        on := fvg_show1
    else if sec == fvg_s2
        on := fvg_show2
    else if sec == fvg_s3
        on := fvg_show3
    on

fvg_isMitigated(bool isBull, float gTop, float gBot, string mode, int sec) =>
    bool m = false
    if mode == FVG_MIT_WICK
        m := isBull ? low <= gTop : high >= gBot
    else if mode == FVG_MIT_FULL
        m := isBull ? low <= gBot : high >= gTop
    else
        bool inside = close >= gBot and close <= gTop
        bool beyond = isBull ? close < gBot : close > gTop
        // judged only when a candle of the FVG's own timeframe closes
        m := fvg_closing(sec) and (inside or beyond)
    m

fvg_isNear(float gTop, float gBot) =>
    float dist = close > gTop ? close - gTop : close < gBot ? gBot - close : 0.0
    fvg_maxDistAtr <= 0 or na(fvg_dAtr) or dist <= fvg_maxDistAtr * fvg_dAtr

fvg_overlapsExisting(bool isBull, float gTop, float gBot, int sec) =>
    bool hit = false
    int n = array.size(fvg_box)
    if n > 0
        for i = 0 to n - 1
            int eSec = array.get(fvg_sec, i)
            if array.get(fvg_bull, i) == isBull and eSec >= sec and fvg_tfOn(eSec) and gBot < array.get(fvg_top, i) and gTop > array.get(fvg_bot, i)
                hit := true
    hit

fvg_extendBox(box b) =>
    if box.get_right(b) <= time
        box.set_right(b, time + fvg_extBars * fvg_barMs)

fvg_addFvg(bool isBull, float gTop, float gBot, int leftTime, string tfTxt, int tfSec) =>
    bool bigEnough = (gTop - gBot) >= fvg_minGapAtr * nz(fvg_dAtr, 0.0)
    bool dup       = fvg_noOverlap and fvg_overlapsExisting(isBull, gTop, gBot, tfSec)
    if bigEnough and not dup
        color c  = isBull ? fvg_bullCol : fvg_bearCol
        bool  on = fvg_showAll and fvg_tfOn(tfSec)
        box b = box.new(leftTime, gTop, time + fvg_extBars * fvg_barMs, gBot,
             xloc = xloc.bar_time,
             border_color = on ? color.new(c, fvg_borderTr) : color(na),
             bgcolor = on ? c : color(na),
             text = fvg_showLabel ? "FVG (" + tfTxt + ")" : "",
             text_halign = text.align_right, text_valign = text.align_center,
             text_size = fvg_lblSize,
             text_color = on ? color.new(c, fvg_lblTransp) : color(na))
        array.push(fvg_box,  b)
        array.push(fvg_top,  gTop)
        array.push(fvg_bot,  gBot)
        array.push(fvg_bar,  bar_index)
        array.push(fvg_bull, isBull)
        array.push(fvg_sec,  tfSec)
        while array.size(fvg_box) > fvg_maxFvg
            box.delete(array.shift(fvg_box))
            array.shift(fvg_top)
            array.shift(fvg_bot)
            array.shift(fvg_bar)
            array.shift(fvg_bull)
            array.shift(fvg_sec)

// Frozen FVGs: same ATR distance + TF toggle + master toggle as live ones
fvg_updateFrozen() =>
    int n = array.size(fz_box)
    if n > 0
        for i = 0 to n - 1
            box b = array.get(fz_box, i)
            bool vis = fvg_showAll and fvg_tfOn(array.get(fz_sec, i)) and fvg_isNear(array.get(fz_top, i), array.get(fz_bot, i))
            box.set_bgcolor(b, vis ? fvg_mitCol : color(na))
            box.set_border_color(b, vis ? color.new(color.gray, 85) : color(na))
            box.set_text_color(b, vis ? color.new(color.gray, 60) : color(na))

// Confirmed-bar pass
fvg_updateAll() =>
    int nF = array.size(fvg_box)
    if nF > 0
        for i = nF - 1 to 0
            box   b      = array.get(fvg_box, i)
            bool  isBull = array.get(fvg_bull, i)
            float gTop   = array.get(fvg_top, i)
            float gBot   = array.get(fvg_bot, i)
            int   gSec   = array.get(fvg_sec, i)
            bool mit = bar_index > array.get(fvg_bar, i) and fvg_isMitigated(isBull, gTop, gBot, fvg_mitMode, gSec)
            if mit
                if fvg_mitDisplay == FVG_MD_DELETE
                    box.delete(b)
                else
                    box.set_right(b, time)
                    array.push(fz_box, b)
                    array.push(fz_top, gTop)
                    array.push(fz_bot, gBot)
                    array.push(fz_sec, gSec)
                    while array.size(fz_box) > 100
                        box.delete(array.shift(fz_box))
                        array.shift(fz_top)
                        array.shift(fz_bot)
                        array.shift(fz_sec)
                array.remove(fvg_box,  i)
                array.remove(fvg_top,  i)
                array.remove(fvg_bot,  i)
                array.remove(fvg_bar,  i)
                array.remove(fvg_bull, i)
                array.remove(fvg_sec,  i)
            if not mit
                fvg_extendBox(b)
                bool  vis  = fvg_showAll and fvg_tfOn(gSec) and fvg_isNear(gTop, gBot)
                color c    = isBull ? fvg_bullCol : fvg_bearCol
                box.set_bgcolor(b, vis ? c : color(na))
                box.set_border_color(b, vis ? color.new(c, fvg_borderTr) : color(na))
                box.set_text_color(b, vis ? color.new(c, fvg_lblTransp) : color(na))

// Live-tick pass (visual only)
fvg_liveTouch() =>
    int nF = array.size(fvg_box)
    if nF > 0
        for i = 0 to nF - 1
            if bar_index > array.get(fvg_bar, i) and fvg_isMitigated(array.get(fvg_bull, i), array.get(fvg_top, i), array.get(fvg_bot, i), fvg_mitMode, array.get(fvg_sec, i))
                box b = array.get(fvg_box, i)
                if fvg_mitDisplay == FVG_MD_DELETE
                    box.set_bgcolor(b, color(na))
                    box.set_border_color(b, color(na))
                    box.set_text_color(b, color(na))
                else
                    box.set_right(b, time)
                    bool vis = fvg_showAll and fvg_tfOn(array.get(fvg_sec, i)) and fvg_isNear(array.get(fvg_top, i), array.get(fvg_bot, i))
                    box.set_bgcolor(b, vis ? fvg_mitCol : color(na))
                    box.set_border_color(b, vis ? color.new(color.gray, 85) : color(na))
                    box.set_text_color(b, vis ? color.new(color.gray, 60) : color(na))

// Builds HTF candles from chart bars and marks the gap on the closing bar of candle C
fvg_scan(string tf, string tfTxt) =>
    var float aH = na
    var float aL = na
    var int   aT = na
    var float bH = na
    var float bL = na
    var int   bT = na
    var float dH = na
    var float dL = na
    var int   dT = na

    int  tfSec   = timeframe.in_seconds(tf)
    bool tfOk    = tfSec >= timeframe.in_seconds()
    int  htfOpen = time(tf)

    if not na(htfOpen)
        if na(dT) or htfOpen != dT
            aH := bH
            aL := bL
            aT := bT
            bH := dH
            bL := dL
            bT := dT
            dH := high
            dL := low
            dT := htfOpen
        else
            dH := math.max(dH, high)
            dL := math.min(dL, low)

    bool lastBar = not na(htfOpen) and time_close(tf) == time_close

    if tfOk and lastBar and barstate.isconfirmed
        if dL > aH
            fvg_addFvg(true,  dL, aH, aT, tfTxt, tfSec)
        if dH < aL
            fvg_addFvg(false, aL, dH, aT, tfTxt, tfSec)
    lastBar

// ───────────── ENGINE ─────────────
if barstate.isconfirmed
    fvg_updateAll()
    fvg_updateFrozen()
else if fvg_liveMit and fvg_mitMode != FVG_MIT_CLOSE
    fvg_liveTouch()

fvg_scan(fvg_tf3, fvg_tfLabel(fvg_tf3))
fvg_scan(fvg_tf2, fvg_tfLabel(fvg_tf2))
fvg_scan(fvg_tf1, fvg_tfLabel(fvg_tf1))
