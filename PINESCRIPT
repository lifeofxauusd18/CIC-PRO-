PSPColor(bool bull, int candleTime, float c1, float o1, int t1, float c2, float o2, int t2, float c3, float o3, int t3, float c4, float o4, int t4) =>
    bool diverge1 = settings.psp_sym1_use and not na(c1) and not na(o1) and t1 == candleTime and (bull != (c1 > o1))
    bool diverge2 = settings.psp_sym2_use and not na(c2) and not na(o2) and t2 == candleTime and (bull != (c2 > o2))
    bool diverge3 = settings.psp_sym3_use and not na(c3) and not na(o3) and t3 == candleTime and (bull != (c3 > o3))
    bool diverge4 = settings.psp_sym4_use and not na(c4) and not na(o4) and t4 == candleTime and (bull != (c4 > o4))
    bool isPSP = settings.psp_show and (diverge1 or diverge2 or diverge3 or diverge4)
    color bodyCol = bull ? settings.psp_up_body : settings.psp_down_body
    [isPSP, bodyCol]

// SMT TF Color and Enable Mapping (Updated for 7H, 6H, 90m)

getSMTConfig(string tf) =>
    int smtTfSeconds = timeframe.in_seconds(tf)
    bool enabled = false
    color col = color.gray

    if smtTfSeconds == 900
        enabled := smt_en_15m
        col := smt_col_15m
    else if smtTfSeconds == 1800
        enabled := smt_en_30m
        col := smt_col_30m
    else if smtTfSeconds == 3600
        enabled := smt_en_1h
        col := smt_col_1h
    else if smtTfSeconds == 5400
        enabled := smt_en_90m
        col := smt_col_90m
    else if smtTfSeconds == 14400
        enabled := smt_en_4h
        col := smt_col_4h
    else if smtTfSeconds == 21600
        enabled := smt_en_6h
        col := smt_col_6h
    else if smtTfSeconds == 25200
        enabled := smt_en_7h
        col := smt_col_7h
    else if tf == "D" or tf == "1D"
        enabled := smt_en_1d
        col := smt_col_1d
    else if tf == "W" or tf == "1W"
        enabled := smt_en_1w
        col := smt_col_1w
    else if tf == "M" or tf == "1M"
        enabled := smt_en_1m
        col := smt_col_1m
    else if tf == "3M"
        enabled := smt_en_3m
        col := smt_col_3m

    [enabled, col]

