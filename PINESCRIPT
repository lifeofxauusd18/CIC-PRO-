f_detect() =>
    bool bullSweep = low[1] < low[2]
    bool bearSweep = high[1] > high[2]

    bool bullBack = close[1] > low[2]
    bool bearBack = close[1] < high[2]

    bool bullColors = close[2] < open[2] and close[1] > open[1]
    bool bearColors = close[2] > open[2] and close[1] < open[1]

    bool bull = bullSweep and (not requireCloseBack or bullBack) and (not requireColors or bullColors)
    bool bear = bearSweep and (not requireCloseBack or bearBack) and (not requireColors or bearColors)

    if bull and bear
        bull := close[1] >= open[1]
        bear := not bull

    int direction = bull ? 1 : bear ? -1 : 0
    float level = bull ? low[2] : bear ? high[2] : na

    [direction, level, time[2], time[1], time_close[1]]

[dirW, levelW, c1W, c2W, endW] = request.security(syminfo.tickerid, "W", f_detect(), lookahead=barmerge.lookahead_off)
[dirD, levelD, c1D, c2D, endD] = request.security(syminfo.tickerid, "D", f_detect(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[dirH4, levelH4, c1H4, c2H4, endH4] = request.security(syminfo.tickerid, "240", f_detect(), lookahead=barmerge.lookahead_off)
[dirH1, levelH1, c1H1, c2H1, endH1] = request.security(syminfo.tickerid, "60", f_detect(), lookahead=barmerge.lookahead_off)
[dirM30, levelM30, c1M30, c2M30, endM30] = request.security(syminfo.tickerid, "30", f_detect(), lookahead=barmerge.lookahead_off)
[dirM15, levelM15, c1M15, c2M15, endM15] = request.security(syminfo.tickerid, "15", f_detect(), lookahead=barmerge.lookahead_off)

int direction = isW1_D1 or isW1_H4 ? dirW :
     isD1_H1 ? dirD :
     isH4_M15 ? dirH4 :
     isH1_M5 ? dirH1 :
     isM30_M3 ? dirM30 : dirM15

float level = isW1_D1 or isW1_H4 ? levelW :
     isD1_H1 ? levelD :
     isH4_M15 ? levelH4 :
     isH1_M5 ? levelH1 :
     isM30_M3 ? levelM30 : levelM15

int c1Time = isW1_D1 or isW1_H4 ? c1W :
     isD1_H1 ? c1D :
     isH4_M15 ? c1H4 :
     isH1_M5 ? c1H1 :
