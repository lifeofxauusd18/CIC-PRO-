        candle.smt_valid1 := not na(candleSet.settings.sym1_t) and candleSet.settings.sym1_t == HTFBarTime
        candle.smt_valid2 := not na(candleSet.settings.sym2_t) and candleSet.settings.sym2_t == HTFBarTime
