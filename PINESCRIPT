                if A.smt_use3 and B.smt_use3 and A.smt_valid3 and B.smt_valid3 and not na(A.smt_h3) and not na(B.smt_h3) and not na(A.smt_l3) and not na(B.smt_l3)
                    bool sym3HH = B.smt_h3 > A.smt_h3
                    bool sym3LL = B.smt_l3 < A.smt_l3
                    if chartHH != sym3HH
                        divLabelsUp := divLabelsUp == "" ? (settings.smt_show_sym3 ? ShortTicker(settings.psp_sym3) : " ") : divLabelsUp + (settings.smt_show_sym3 ? " " + ShortTicker(settings.psp_sym3) : "")
                    if chartLL != sym3LL
                        divLabelsDown := divLabelsDown == "" ? (settings.smt_show_sym3 ? ShortTicker(settings.psp_sym3) : " ") : divLabelsDown + (settings.smt_show_sym3 ? " " + ShortTicker(settings.psp_sym3) : "")
                if A.smt_use4 and B.smt_use4 and A.smt_valid4 and B.smt_valid4 and not na(A.smt_h4) and not na(B.smt_h4) and not na(A.smt_l4) and not na(B.smt_l4)
                    bool sym4HH = B.smt_h4 > A.smt_h4
                    bool sym4LL = B.smt_l4 < A.smt_l4
                    if chartHH != sym4HH
                        divLabelsUp := divLabelsUp == "" ? ShortTicker(settings.psp_sym4) : divLabelsUp + " " + ShortTicker(settings.psp_sym4)
                    if chartLL != sym4LL
                        divLabelsDown := divLabelsDown == "" ? ShortTicker(settings.psp_sym4) : divLabelsDown + " " + ShortTicker(settings.psp_sym4)

                bool bearishSMT = divLabelsUp != ""
                bool bullishSMT = divLabelsDown != ""
                bool filterPass = true
                if settings.followAutoHTFFilter
                    bool isBullCandle = B.c > B.o
                    if bearishSMT and isBullCandle
                        filterPass := false
                    if bullishSMT and not isBullCandle
                        filterPass := false

                // Chart-bar ranges that belong to candle A and candle B
                int aEnd = B.bar_idx - 1
                int bEnd = i == 0 ? bar_index : candleSet.candles.get(i - 1).bar_idx - 1

                if filterPass
                    if bearishSMT
                        hasSMT := true
                        if settings.showHTFSMT
                            B.smt_high_line := line.new(A_cx, A.h, B_cx, B.h, xloc=xloc.bar_index, color=cleanSMTColor, width=div_line_width, style=LineStyle(div_line_style))
                        if settings.showChartSMT
                            [aHiIdx, aHiPx] = f_exactPeak(A.bar_idx, aEnd, true, A.high_bar_idx, A.h)
                            [bHiIdx, bHiPx] = f_exactPeak(B.bar_idx, bEnd, true, B.high_bar_idx, B.h)
                            ln = line.new(aHiIdx, aHiPx, bHiIdx, bHiPx, xloc=xloc.bar_index, color=cleanSMTColor, width=div_line_width, style=LineStyle(div_line_style))
                            array.push(chartSmtLines, ln)
