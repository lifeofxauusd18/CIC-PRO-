            if settings.sweep_show and not hasSMT
                if B.h > A.h
                    B.sweep_high_line := line.new(A_cx, A.h, B_r, A.h, xloc = xloc.bar_index, color = sweepColor, width = 1, style = line.style_solid)
                if B.l < A.l
