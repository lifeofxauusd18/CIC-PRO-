                            array.push(chartSmtLabels, lbl)
                        if settings.smt_label_show
                            string combinedText = bearishSMT and str.trim(divLabelsUp) != "" ? str.trim(divLabelsUp) + " / " + str.trim(divLabelsDown) : str.trim(divLabelsDown)
                            B.smt_label := label.new(B_cx, B.l, combinedText, xloc=xloc.bar_index, style=label.style_label_up, color=color_transparent, textcolor=cleanSMTColor, size=size.tiny)

            if settings.sweep_show and not hasSMT
                if B.h > A.h
                    B.sweep_high_line := line.new(A_cx, A.h, B_r, A.h, xloc = xloc.bar_index, color = sweepColor, width = 1, style = line.style_solid)
                if B.l < A.l
