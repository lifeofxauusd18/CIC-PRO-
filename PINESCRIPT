fr_name(string t) =>
    int s = timeframe.in_seconds(t)
    s < 3600 ? str.tostring(int(s / 60)) + 'm' : s < 86400 ? str.tostring(int(s / 3600)) + 'H' : s == 86400 ? '1D' : s <= 604800 ? '1W' : '1M'

string fr_htfTf = switch fr_model
    '1m-15m' => '15'
    '3m-30m' => '30'
    '5m-1H'  => '60'
    '15m-4H' => '240'
    '1H-1D'  => '1D'
    '4H-1W'  => '1W'
    '1D-1W'  => '1W'
    'Custom' => fr_cHTF
    =>          fr_autoHTF()

bool   fr_valid   = fr_model == 'Auto' ? fr_isAutoValid(fr_tfMins(fr_curTf())) : fr_tfMins(fr_curTf()) <= fr_tfMins(fr_ltf())
string fr_htfName = fr_name(fr_htfTf)
string fr_ltfName = fr_name(fr_ltf())

// ─────────────── HTF DATA ───────────────
[fr_curH, fr_curL, fr_curC, fr_prevH1, fr_prevL1] = request.security(syminfo.tickerid, fr_htfTf, [high[0], low[0], close[0], high[1], low[1]], lookahead = barmerge.lookahead_on)

bool fr_c2Buy  = fr_curL < fr_prevL1 and fr_curC > fr_prevL1
bool fr_c2Sell = fr_curH > fr_prevH1 and fr_curC < fr_prevH1
bool fr_periodChanged = time(fr_htfTf) != time(fr_htfTf)[1]

var float fr_cH = na
var float fr_cL = na
var int   fr_cHBar = na
var int   fr_cLBar = na
var float fr_pH = na
var float fr_pL = na
var int   fr_pHBar = na
var int   fr_pLBar = na
var bool  fr_prevBuy = false
var bool  fr_prevSell = false

if fr_periodChanged
    fr_pH := fr_cH
    fr_pL := fr_cL
    fr_pHBar := fr_cHBar
    fr_pLBar := fr_cLBar
    fr_cH := high
    fr_cL := low
    fr_cHBar := bar_index
    fr_cLBar := bar_index
    fr_prevBuy  := fr_c2Buy[1]
    fr_prevSell := fr_c2Sell[1]
else
    if high > fr_cH
        fr_cH := high
        fr_cHBar := bar_index
    if low < fr_cL
        fr_cL := low
        fr_cLBar := bar_index

// ─────────────── DRAW HELPERS ───────────────
fr_dirLabel(int x, float y, string txt, bool bullish) =>
    label.new(x, y, text = txt, xloc = xloc.bar_index, yloc = yloc.price, style = bullish ? label.style_label_up : label.style_label_down, color = na, textcolor = color.gray, size = size.small, text_font_family = font.family_monospace)

fr_topBot() =>
    float mid = (fr_pH + fr_pL) / 2
    [math.max(open, mid), math.min(open, mid)]

fr_drawPhase(bool isBull, bool isC4, int startBar, float top, float bot) =>
    float yDash = isBull ? bot : top
    box   bx   = fr_showT ? box.new(startBar, top, bar_index, bot, border_color = na, bgcolor = isBull ? fr_bullBox : fr_bearBox) : na
    line  dash = fr_showDashL ? line.new(startBar, yDash, bar_index, yDash, color = fr_dashCol, width = 1, style = line.style_dotted) : na
    label lbl  = na
    if isC4 and fr_showT and fr_showLbl and fr_valid
        lbl := fr_dirLabel(bar_index + 2, isBull ? bot : top, 'C4', isBull)
    [bx, dash, lbl]

fr_deleteVisuals(FrSetup s) =>
    if not na(s)
        if not na(s.c2Lbl)
            label.delete(s.c2Lbl)
        if not na(s.c3Box)
            box.delete(s.c3Box)
        if not na(s.c3Dash)
            line.delete(s.c3Dash)
        if not na(s.c4Box)
            box.delete(s.c4Box)
        if not na(s.c4Dash)
            line.delete(s.c4Dash)
        if not na(s.c4Lbl)
            label.delete(s.c4Lbl)

fr_register(FrSetup s) =>
    fr_records.push(FrRecord.new(s, bar_index))
    while fr_hist > 0 and fr_records.size() > fr_hist
        evicted = fr_records.shift()
        fr_deleteVisuals(evicted.setup)

// ─────────────── SETUP LOGIC ───────────────
fr_newSetup(bool isBull, float extremePrice, int extremeBar) =>
    FrSetup s = FrSetup.new(isBull, extremePrice, 1, false)
    s.c2Bar := extremeBar
    s.c2Price := extremePrice
    if fr_valid and fr_showLbl and not na(extremeBar)
        s.c2Lbl := fr_dirLabel(extremeBar, extremePrice, 'C2 (' + fr_htfName + ')', isBull)
    [top, bot] = fr_topBot()
    [bx, dash, _l] = fr_drawPhase(isBull, false, bar_index, top, bot)
    s.c3Box := bx
    s.c3Dash := dash
    fr_register(s)
    s

method advanceToC4(FrSetup s) =>
    if not na(s.c3Box)
        box.set_right(s.c3Box, bar_index)
    if not na(s.c3Dash)
        line.set_x2(s.c3Dash, bar_index)
    [top, bot] = fr_topBot()
    s.c4Top := top
    s.c4Bottom := bot
    [bx, dash, lbl] = fr_drawPhase(s.isBull, true, bar_index, top, bot)
    s.c4Box := bx
    s.c4Dash := dash
    s.c4Lbl := lbl
    s.phase := 2
    s.c4Invalid := false
    s

method finish(FrSetup s) =>
    if not na(s.c4Box)
        box.set_right(s.c4Box, bar_index)
    if not na(s.c4Dash)
        line.set_x2(s.c4Dash, bar_index)
    s.phase := 0
    s

method extendAndCheck(FrSetup s) =>
    if not na(s) and not s.dead and s.phase != 0
        box  extBox  = s.phase == 1 ? s.c3Box : s.c4Box
        line extDash = s.phase == 1 ? s.c3Dash : s.c4Dash
        if not na(extBox)
            box.set_right(extBox, bar_index)
        if not na(extDash)
            line.set_x2(extDash, bar_index)
        bool breach = s.isBull ? low < s.extreme : high > s.extreme
        if breach
            if not na(s.c3Box)
                box.delete(s.c3Box)
                s.c3Box := na
            if not na(s.c3Dash)
                line.delete(s.c3Dash)
                s.c3Dash := na
            if not na(s.c4Box)
                box.delete(s.c4Box)
                s.c4Box := na
            if not na(s.c4Dash)
                line.delete(s.c4Dash)
                s.c4Dash := na
            if not na(s.c4Lbl)
                label.delete(s.c4Lbl)
                s.c4Lbl := na
            s.dead := true
            s.phase := 0
    s

method checkC4Invalid(FrSetup s) =>
    if not na(s) and not s.dead and s.phase == 2 and not s.c4Invalid
        bool invalid = s.isBull ? close[1] < s.c4Bottom : close[1] > s.c4Top
        if invalid
            s.c4Invalid := true
            if not na(s.c4Box)
                box.delete(s.c4Box)
                s.c4Box := na
            if not na(s.c4Dash)
                line.delete(s.c4Dash)
                s.c4Dash := na
            if not na(s.c4Lbl)
                label.delete(s.c4Lbl)
                s.c4Lbl := na
    s

fr_processC2(bool trigger, bool allow, bool isBull, float extremePrice, int extremeBar, FrSetup existing) =>
    FrSetup result = existing
    if trigger and allow
        result := fr_newSetup(isBull, extremePrice, extremeBar)
    else if fr_periodChanged and not na(existing) and not existing.dead
        result := existing.phase == 1 ? existing.advanceToC4() : existing.phase == 2 ? existing.finish() : existing
    result

// ─────────────── MAIN LOGIC ───────────────
bool fr_buyTrig  = fr_show and fr_periodChanged and fr_prevBuy
bool fr_sellTrig = fr_show and fr_periodChanged and fr_prevSell

fr_buy  := fr_processC2(fr_buyTrig,  fr_allowBuy,  true,  fr_pL, fr_pLBar, fr_buy)
fr_sell := fr_processC2(fr_sellTrig, fr_allowSell, false, fr_pH, fr_pHBar, fr_sell)

if fr_show
    fr_buy  := fr_buy.extendAndCheck()
    fr_sell := fr_sell.extendAndCheck()
    fr_buy  := fr_buy.checkC4Invalid()
    fr_sell := fr_sell.checkC4Invalid()

if fr_alerts
    if fr_buyTrig and fr_allowBuy
        alert('Bullish C2 (' + fr_htfName + ') formed on ' + syminfo.ticker, alert.freq_once_per_bar)
    if fr_sellTrig and fr_allowSell
        alert('Bearish C2 (' + fr_htfName + ') formed on ' + syminfo.ticker, alert.freq_once_per_bar)

