                            array.push(chartSmtLabels, lbl)
                        if settings.smt_label_show and not bullishSMT
                            B.smt_label := label.new(B_cx, B.h, str.trim(divLabelsUp), xloc=xloc.bar_index, style=label.style_label_down, color=color_transparent, textcolor=cleanSMTColor, size=size.tiny)

                    if bullishSMT
                        hasSMT := true
                        if settings.showHTFSMT
                            B.smt_low_line := line.new(A_cx, A.l, B_cx, B.l, xloc=xloc.bar_index, color=cleanSMTColor, width=div_line_width, style=LineStyle(div_line_style))
                        if settings.showChartSMT
                            [aLoIdx, aLoPx] = f_exactPeak(A.bar_idx, aEnd, false, A.low_bar_idx, A.l)
                            [bLoIdx, bLoPx] = f_exactPeak(B.bar_idx, bEnd, false, B.low_bar_idx, B.l)
                            ln = line.new(aLoIdx, aLoPx, bLoIdx, bLoPx, xloc=xloc.bar_index, color=cleanSMTColor, width=div_line_width, style=LineStyle(div_line_style))
                            array.push(chartSmtLines, ln)
