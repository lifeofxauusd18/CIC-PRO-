const bool CISD_FIB_ENGINE = true
int CISD_FIB_MIN_SPACING_MS = cisd_fib_min_minutes * 60 * 1000
int pivot_len = 1
bool pivot_delete_on_cross = true
bool cisd_invalidate_on_cross = true

string cisd_sensitivity     = 'Standard'
int    cisd_pending_timeout = cisd_sensitivity == 'Standard' ? 10 : 20
bool   cisd_exhaustive      = false

type CISDStretch
    bool bullish
    int origin_bar
    float level
    int end_bar
    float end_close
    float origin_high
    float origin_low
    int run_ext_bar
    float run_ext_price

type PendingCISD
