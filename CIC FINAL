method Reorder(CandleSet candleSet, int offset) =>
    size = candleSet.candles.size()
    if size > 0
        for i = size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            t_buffer = offset + (settings.width + settings.buffer) * (size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            line.set_x1(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_up, bar_index + settings.width / 2 + t_buffer)
            line.set_x1(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
            line.set_x2(candle.wick_down, bar_index + settings.width / 2 + t_buffer)
    top = 0.0
    bottom = 0.0
    if settings.label_alignment == 'Align'
        top := f_allHigh(candleSet.candles)
        bottom := f_allLow(candleSet.candles, top)
    if settings.label_alignment == 'Follow Candles'
        top := candleSet.candles.CandleSetHigh(0)
        bottom := candleSet.candles.CandleSetLow(top)
    left = bar_index + offset + (settings.width + settings.buffer) * (size - 1) / 2
    if settings.htf_label_show
        string lblt = HTFName(candleSet.settings.htf)
        string lbll = lblt
        if settings.htf_timer_show
            lblt := lblt + '\n'
            lbll := '\n' + lbll
        string tmr = '(' + RemainingTime(candleSet.settings.htf) + ')'
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
            else
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_down, size = settings.htf_label_size)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerTop)
                    candleSet.tfTimerTop.set_xy(left, top)
                else
                    candleSet.tfTimerTop := label.new(left, top, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_down, size = settings.htf_timer_size)
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
            else
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.htf_label_color, style = label.style_label_up, size = settings.htf_label_size)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerBottom)
                    candleSet.tfTimerBottom.set_xy(left, bottom)
                else
                    candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.htf_timer_color, style = label.style_label_up, size = settings.htf_timer_size)
    candleSet

method FindImbalance(CandleSet candleSet) =>
    if barstate.isrealtime or barstate.islast
        if candleSet.imbalances.size() > 0
            for i = candleSet.imbalances.size() - 1 to 0 by 1
                Imbalance del = candleSet.imbalances.get(i)
                box.delete(del.b)
                candleSet.imbalances.pop()
        if candleSet.candles.size() > 3 and settings.fvg_show
            for i = 0 to candleSet.candles.size() - 3 by 1
                candle1 = candleSet.candles.get(i)
                candle2 = candleSet.candles.get(i + 2)
                candle3 = candleSet.candles.get(i + 1)
                if candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_left(candle2.body), candle2.h, box.get_right(candle1.body), candle1.l, bgcolor = settings.fvg_color, border_color = color_transparent, xloc = xloc.bar_index)
                    candleSet.imbalances.push(imb)
                if candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_right(candle1.body), candle1.h, box.get_left(candle2.body), candle2.l, bgcolor = settings.fvg_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
                box temp = box.copy(candle3.body)
                box.delete(candle3.body)
                candle3.body := temp
        if candleSet.candles.size() > 2 and settings.vi_show
            for i = 0 to candleSet.candles.size() - 2 by 1
                candle1 = candleSet.candles.get(i)
                candle2 = candleSet.candles.get(i + 1)
                if candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_left(candle2.body), math.min(candle1.o, candle1.c), box.get_right(candle1.body), math.max(candle2.o, candle2.c), bgcolor = settings.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
                if candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_right(candle1.body), math.min(candle2.o, candle2.c), box.get_left(candle2.body), math.max(candle1.o, candle1.c), bgcolor = settings.vi_color, border_color = color_transparent)
                    candleSet.imbalances.push(imb)
    candleSet

// HTF-panel sweep lines (ported from the GXV HTF Profiler pane logic).
// C1 = candles[i], C2 = candles[i-1] (the next candle), C3 = candles[i-2].
// High sweep: C2 wicks above C1 high and closes back below it. Low sweep: mirror.
// Cancelled if any later candle (C2 included) closes beyond the swept level.
// Line runs from C1's center to C3's center (or C2's right edge when no C3 exists yet).
// Only the latest `in_sweepCap` valid sweeps per direction are drawn.
method DrawSweeps(CandleSet candleSet) =>
    if (barstate.isrealtime or barstate.islast) and candleSet.candles.size() >= 1
        int sz = candleSet.candles.size()
        for i = 0 to sz - 1
            Candle A = candleSet.candles.get(i)
            if not na(A.sweep_high_line)
                line.delete(A.sweep_high_line)
                A.sweep_high_line := na
            if not na(A.sweep_low_line)
                line.delete(A.sweep_low_line)
                A.sweep_low_line := na
        if settings.sweep_show and sz >= 2
            int highCount = 0
            int lowCount = 0
            for i = 1 to sz - 1
                Candle c1 = candleSet.candles.get(i)
                Candle c2 = candleSet.candles.get(i - 1)
                bool hi = c2.h > c1.h and c2.c < c1.h
                bool lo = c2.l < c1.l and c2.c > c1.l
                if (hi or lo) and i >= 2
                    for k = 0 to i - 2
                        Candle nw = candleSet.candles.get(k)
                        if nw.c > c1.h
                            hi := false
                        if nw.c < c1.l
                            lo := false
                if hi and highCount < in_sweepCap
                    int x1 = box.get_left(c1.body) + settings.width / 2
                    int x2 = i >= 2 ? box.get_left(candleSet.candles.get(i - 2).body) + settings.width / 2 : box.get_right(c2.body)
                    c1.sweep_high_line := line.new(x1, c1.h, x2, c1.h, xloc = xloc.bar_index, color = settings.sweep_color, width = 1, style = line.style_solid)
                    highCount += 1
                if lo and lowCount < in_sweepCap
                    int x1 = box.get_left(c1.body) + settings.width / 2
                    int x2 = i >= 2 ? box.get_left(candleSet.candles.get(i - 2).body) + settings.width / 2 : box.get_right(c2.body)
                    c1.sweep_low_line := line.new(x1, c1.l, x2, c1.l, xloc = xloc.bar_index, color = settings.sweep_color, width = 1, style = line.style_solid)
                    lowCount += 1
    candleSet

method Monitor(CandleSet candleSet) =>
    int HTFBarTime = time(candleSet.settings.htf)
    isNewHTFCandle = ta.change(HTFBarTime) > 0
    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := nz(candleSet.settings.own_o, open)
        candle.c := nz(candleSet.settings.own_c, close)
        candle.h := nz(candleSet.settings.own_h, high)
        candle.l := nz(candleSet.settings.own_l, low)
        candle.o_time := HTFBarTime
        candle.bar_idx := bar_index
        candle.high_bar_idx := bar_index
        candle.low_bar_idx := bar_index
        bull = candle.c > candle.o
        [isPSP, pspBody] = PSPColor(bull, HTFBarTime, candleSet.settings.sym1_c, candleSet.settings.sym1_o, candleSet.settings.sym1_t, candleSet.settings.sym2_c, candleSet.settings.sym2_o, candleSet.settings.sym2_t, candleSet.settings.sym3_c, candleSet.settings.sym3_o, candleSet.settings.sym3_t, candleSet.settings.sym4_c, candleSet.settings.sym4_o, candleSet.settings.sym4_t)
        color bodyColor = isPSP ? pspBody : (bull ? settings.bull_body : settings.bear_body)
        color borderColor = bull ? settings.bull_border : settings.bear_border
        color wickColor = bull ? settings.bull_wick : settings.bear_wick
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), borderColor, 1, bgcolor = bodyColor)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = wickColor)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = wickColor)
        candleSet.candles.unshift(candle)
        if candleSet.candles.size() > candleSet.settings.max_display
            Candle delCandle = array.pop(candleSet.candles)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.sweep_high_line)
                line.delete(delCandle.sweep_high_line)
            if not na(delCandle.sweep_low_line)
                line.delete(delCandle.sweep_low_line)
    candleSet

// NOTE: positioning (Reorder) is done in f_panelPlace() so panels are ordered by timeframe.
method Update(CandleSet candleSet, int offset) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        bool isLiveCandle = candle.o_time == time(candleSet.settings.htf)
        if isLiveCandle
            candle.h := nz(candleSet.settings.own_h, math.max(candle.h, high))
            candle.l := nz(candleSet.settings.own_l, math.min(candle.l, low))
            candle.c := nz(candleSet.settings.own_c, close)
            if high >= candle.h - syminfo.mintick / 2
                candle.high_bar_idx := bar_index
            if low <= candle.l + syminfo.mintick / 2
                candle.low_bar_idx := bar_index
        bull = candle.c > candle.o
        if isLiveCandle
            int HTFBarTime = time(candleSet.settings.htf)
            [isPSP, pspBody] = PSPColor(bull, HTFBarTime, candleSet.settings.sym1_c, candleSet.settings.sym1_o, candleSet.settings.sym1_t, candleSet.settings.sym2_c, candleSet.settings.sym2_o, candleSet.settings.sym2_t, candleSet.settings.sym3_c, candleSet.settings.sym3_o, candleSet.settings.sym3_t, candleSet.settings.sym4_c, candleSet.settings.sym4_o, candleSet.settings.sym4_t)
            color bodyColor = isPSP ? pspBody : (bull ? settings.bull_body : settings.bear_body)
            color borderColor = bull ? settings.bull_border : settings.bear_border
            color wickColor = bull ? settings.bull_wick : settings.bear_wick
            box.set_bgcolor(candle.body, bodyColor)
            box.set_border_color(candle.body, borderColor)
            line.set_color(candle.wick_up, wickColor)
            line.set_color(candle.wick_down, wickColor)
            box.set_top(candle.body, candle.o)
            box.set_bottom(candle.body, candle.c)
            line.set_y1(candle.wick_up, candle.h)
            line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
            line.set_y1(candle.wick_down, candle.l)
            line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
    candleSet

// Phase 1: update data only (no positioning)
f_panelRun(CandleSet s, int offset) =>
    s.UpdateTime(offset)
    s.Monitor().Update(offset)
    true

// Phase 2: position the panel, then build its imbalances
f_panelPlace(CandleSet s, int offset) =>
    if barstate.isrealtime or barstate.islast
        if s.candles.size() > 0
            s.Reorder(offset)
    s.FindImbalance()
    true

// Sort key = timeframe length in seconds (slot index only breaks ties); na = panel not shown
f_panelKey(CandleSet s, int slot) =>
    s.settings.show and ValidTimeframe(s.settings.htf) ? timeframe.in_seconds(s.settings.htf) + slot * 0.001 : na

f_panelWidth(CandleSet s) =>
    int n = s.candles.size()
    n > 0 ? n * settings.width + (n - 1) * settings.buffer : 0

// Offset of panel `i` = padding + width of every shown panel with a shorter timeframe
f_panelOffset(int i, array<float> keys, array<int> ws) =>
    int off = settings.offset
    float mk = keys.get(i)
    for j = 0 to 5
        float kj = keys.get(j)
        if not na(kj) and kj < mk
            off += ws.get(j) + settings.htf_buffer
    off

