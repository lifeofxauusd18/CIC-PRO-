// ═════════════ BIAS ENGINE ═════════════
float chartSecB = timeframe.in_seconds(timeframe.period)
string biasTfRaw = switch biasTfIn
    '15m' => '15'
    '30m' => '30'
    '1H'  => '60'
    '4H'  => '240'
    '1D'  => 'D'
    '1W'  => 'W'
    =>       chartSecB <= 300 ? '60' : chartSecB <= 900 ? '240' : chartSecB <= 3600 ? 'D' : 'W'
string biasTFeff = timeframe.in_seconds(biasTfRaw) > chartSecB ? biasTfRaw : timeframe.period

f_biasData() =>
    bool sweepBear = high > high[1] and close < high[1]
    bool sweepBull = low < low[1] and close > low[1]
    [high[1], low[1], close, sweepBear[1], sweepBull[1]]

[bPdh, bPdl, bCls, bSweepBear, bSweepBull] = request.security(syminfo.tickerid, biasTFeff, f_biasData(), lookahead = barmerge.lookahead_off)

bool biasNewCandle = ta.change(time(biasTFeff)) != 0
var int biasDir = 0   // 1 bull, -1 bear, 0 none
var int seqDir  = 0
var int seqN    = 0   // 3 = candle after the sweep candle (C3), 4 = C4, then reset

if biasNewCandle
    if bSweepBear != bSweepBull
        seqDir := bSweepBear ? -1 : 1
        seqN := 3
    else if seqN > 0
        seqN += 1
        if seqN > 4
            seqN := 0
            seqDir := 0

if seqN > 0 and seqDir != 0
    biasDir := seqDir
else if not na(bCls) and not na(bPdh) and not na(bPdl)
    if bCls > bPdh
        biasDir := 1
    else if bCls < bPdl
        biasDir := -1

