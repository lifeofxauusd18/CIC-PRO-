createLevel(array<line> ls, array<label> lbs, float price, string txt, bool showLbl) =>
    line ln = line.new(
         x1=bar_index,
         y1=price,
         x2=bar_index + rightPad,
         y2=price,
         xloc=xloc.bar_index,
         extend=extend.none,
         color=lineColor,
         style=LineStyle(lineStyle),
         width=lineWidth)
    array.push(ls, ln)

    label lb = na
    if showLbl
        lb := label.new(
             x=bar_index + rightPad + labelPad,
             y=price,
             text=txt,
             xloc=xloc.bar_index,
             yloc=yloc.price,
             style=label.style_none,
             color=color.new(lineColor, 100),
             textcolor=lvlTextColor,
             size=lvlTextSize,
             textalign=text.align_left)
    array.push(lbs, lb)

updateLevel(array<line> ls, array<label> lbs, float price) =>
    if array.size(ls) > 0
        line ln = array.get(ls, array.size(ls) - 1)
        line.set_x2(ln, bar_index + rightPad)
        line.set_y1(ln, price)
        line.set_y2(ln, price)

        if array.size(lbs) > 0
            label lb = array.get(lbs, array.size(lbs) - 1)
            if not na(lb)
                label.set_x(lb, bar_index + rightPad + labelPad)
                label.set_y(lb, price)

freezeLevel(array<line> ls) =>
    if array.size(ls) > 0
        line ln = array.get(ls, array.size(ls) - 1)
        line.set_x2(ln, math.max(line.get_x1(ln), bar_index - 1))

trimLevels(array<line> ls, array<label> lbs, int depth) =>
    while array.size(ls) > depth
        line.delete(array.shift(ls))

    while array.size(lbs) > depth
        label lb = array.shift(lbs)
        if not na(lb)
            label.delete(lb)

