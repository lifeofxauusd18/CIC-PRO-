// Accumulates one HTF candle (open / close / high / low / candle open time) from chart-timeframe values.
f_htfOHLC(string tf, float o_, float c_, float h_, float l_) =>
    var float ro = na
    var float rc = na
    var float rh = na
    var float rl = na
    var int   rt = na
    int t = time(tf)
    if not na(t)
        if na(rt) or t != rt
            ro := o_
            rh := h_
            rl := l_
            rt := t
        else
            if na(ro)
                ro := o_
            if not na(h_)
                rh := na(rh) ? h_ : math.max(rh, h_)
            if not na(l_)
                rl := na(rl) ? l_ : math.min(rl, l_)
        if not na(c_)
            rc := c_
    [ro, rc, rh, rl, na(ro) ? int(na) : rt]

