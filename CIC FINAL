        int bi = -1
        bool bseq = false
        for i = 2 to n - 1
            Candle c1 = s.candles.get(i)
            Candle c2 = s.candles.get(i - 1)
            bool bear = c2.h > c1.h and c2.c < c1.h
            bool bull = c2.l < c1.l and c2.c > c1.l
            for k = 0 to i - 2
                Candle nw = s.candles.get(k)
                if nw.h > c2.h
                    bear := false
                if nw.l < c2.l
                    bull := false
            if bear or bull
                bi := i
                bseq := bull and not bear ? true : bear and not bull ? false : c2.c > c2.o
                break
        if bi >= 0
            Candle c1 = s.candles.get(bi)
            Candle c2 = s.candles.get(bi - 1)
            f_c123Put(c1, "C1", bseq)
            f_c123Put(c2, "C2", bseq)
            if bi >= 2
                Candle c3 = s.candles.get(bi - 2)
                bool c3ok = bseq ? c3.h > c2.h : c3.l < c2.l
                for k = 0 to bi - 3
                    Candle nw = s.candles.get(k)
                    if bseq ? nw.l < c3.l : nw.h > c3.h
                        c3ok := false
                if c3ok
                    f_c123Put(c3, "C3", bseq)
