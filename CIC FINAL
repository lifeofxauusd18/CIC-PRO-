ValidTimeframe(string HTF) =>
    int chartSeconds = timeframe.in_seconds(timeframe.period)
    int htfSeconds = timeframe.in_seconds(HTF)
    not na(chartSeconds) and not na(htfSeconds) and htfSeconds > chartSeconds

RemainingTime(string HTF) =>
    if barstate.isrealtime
        timeRemaining = (time_close(HTF) - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)
        r = str.tostring(seconds, '00')
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
        if days > 0
            r := str.tostring(days) + 'D ' + r
        r
    else
        'n/a'

HTFName(string HTF) =>
    seconds = timeframe.in_seconds(HTF)
    seconds < 60 ? str.tostring(seconds) + 's' : seconds / 60 < 60 ? str.tostring(seconds / 60) + 'm' : seconds / 60 / 60 < 24 ? str.tostring(seconds / 60 / 60) + 'H' : HTF

ShortTicker(string symbol) =>
    string t = syminfo.ticker(symbol)
    string upper = str.upper(t)
    str.contains(upper, 'MNQ') ? 'NQ' : str.contains(upper, 'MES') ? 'ES' : str.contains(upper, 'MYM') ? 'YM' : str.contains(upper, 'NQ') ? 'NQ' : str.contains(upper, 'ES') ? 'ES' : str.contains(upper, 'YM') ? 'YM' : t

SameInstrument(string symbol) =>
    string chartRoot = ShortTicker(syminfo.tickerid)
    string refRoot = ShortTicker(symbol)
    chartRoot == refRoot

PSPColor(bool bull, int candleTime, float c1, float o1, int t1, float c2, float o2, int t2, float c3, float o3, int t3, float c4, float o4, int t4) =>
    bool diverge1 = settings.psp_sym1_use and not na(c1) and not na(o1) and t1 == candleTime and (bull != (c1 > o1))
    bool diverge2 = settings.psp_sym2_use and not na(c2) and not na(o2) and t2 == candleTime and (bull != (c2 > o2))
    bool diverge3 = settings.psp_sym3_use and not na(c3) and not na(o3) and t3 == candleTime and (bull != (c3 > o3))
    bool diverge4 = settings.psp_sym4_use and not na(c4) and not na(o4) and t4 == candleTime and (bull != (c4 > o4))
    bool isPSP = settings.psp_show and (diverge1 or diverge2 or diverge3 or diverge4)
    color bodyCol = bull ? settings.psp_up_body : settings.psp_down_body
    [isPSP, bodyCol]

// Methods
method CandleSetHigh(array<Candle> candles, float h) =>
    _h = h
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c = array.get(candles, i)
            if c.h > _h
                _h := c.h
    _h

method CandleSetLow(array<Candle> candles, float l) =>
    _l = l
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c = array.get(candles, i)
            if c.l < _l
                _l := c.l
    _l

// Highest / lowest across ALL enabled panels (used for 'Align' label mode)
f_allHigh(array<Candle> candles) =>
    float h = 0.0
    for s in allSets
        if s.settings.show and ValidTimeframe(s.settings.htf)
            h := s.candles.CandleSetHigh(h)
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c = array.get(candles, i)
            if c.h > h
                h := c.h
    h

f_allLow(array<Candle> candles, float startVal) =>
    float l = startVal
    for s in allSets
        if s.settings.show and ValidTimeframe(s.settings.htf)
            l := s.candles.CandleSetLow(l)
    if array.size(candles) > 0
        for i = 0 to array.size(candles) - 1
            Candle c = array.get(candles, i)
            if c.l < l
                l := c.l
    l

