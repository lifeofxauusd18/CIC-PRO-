isOpeningTime(int targetHour, int targetMinute) =>
    int targetTime = timestamp(
         "America/New_York",
         year(time, tz),
         month(time, tz),
         dayofmonth(time, tz),
         targetHour,
         targetMinute)

    time <= targetTime and time_close > targetTime

