// Clear all sweep lines from a candle (called when candle scrolls off or C1 no longer exists)
clearAllHTFCandleSweeps(Candle candle) =>
    if not na(candle.sweep_lines) and candle.sweep_lines.size() > 0
        for i = candle.sweep_lines.size() - 1 to 0 by 1
            line l = candle.sweep_lines.get(i)
            if not na(l)
                line.delete(l)
        candle.sweep_lines.clear()
        candle.sweep_c1_indices.clear()
        candle.sweep_is_bullish.clear()
        candle.sweep_c1_levels.clear()

// Detect sweeps on HTF candles
// C2 (current candle, index 0) sweeps C1 (immediate prior, index 1)
// Called both on candle creation and during updates to catch sweeps as they develop
method DetectCandleSetSweeps(CandleSet candleSet) =>
    if candleSet.candles.size() >= 2 and settings.sweep_show
        Candle c2 = candleSet.candles.get(0)
        Candle c1 = candleSet.candles.get(1)
        
        // Bullish sweep: C2 sweeps C1's low then closes above it
        bool bullishSweep = c2.l < c1.l and c2.c > c1.l
        
        // Bearish sweep: C2 sweeps C1's high then closes below it
        bool bearishSweep = c2.h > c1.h and c2.c < c1.h
        
        if (bullishSweep or bearishSweep) and not na(c1.body) and not na(c2.body)
            // Check if we already have a sweep for this C1 (avoid duplicates)
            bool alreadyHasSweep = false
            if not na(c2.sweep_lines) and c2.sweep_lines.size() > 0
                for i = 0 to c2.sweep_lines.size() - 1 by 1
                    if c2.sweep_c1_indices.get(i) == c1.o_idx
                        alreadyHasSweep := true
                        break
            
            if not alreadyHasSweep
                int x1 = box.get_left(c1.body) + 1
                int x2 = box.get_right(c2.body)
                float yLevel = bullishSweep ? c1.l : c1.h
                
                line sweepLine = line.new(x1, yLevel, x2, yLevel, color = settings.sweep_color, style = helper.LineStyle(settings.sweep_style), width = settings.sweep_width)
                
                // Store sweep data on C2 (parallel arrays)
                c2.sweep_lines.push(sweepLine)
                c2.sweep_c1_indices.push(c1.o_idx)
                c2.sweep_is_bullish.push(bullishSweep)
                c2.sweep_c1_levels.push(yLevel)
    candleSet

