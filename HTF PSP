// matchAsset helper: Determines if chart matches a given asset ticker
// Uses exact matching for futures, fuzzy matching for CFD/forex/crypto
matchAsset(string assetTicker) =>
    if str.length(assetTicker) == 0
        false
    else
        string chartTicker = syminfo.ticker
        string chartTickerId = syminfo.tickerid
        bool isFutures = syminfo.type == "futures"
        bool result = false
        if isFutures
            // Futures: exact match on ticker portion (handles continuous vs specific contracts)
            result := str.contains(chartTickerId, assetTicker) or str.contains(assetTicker, chartTicker)
        else
            // CFD/Forex/Crypto: fuzzy match on base symbol
            result := str.contains(chartTickerId, assetTicker) or str.contains(assetTicker, chartTicker) or str.contains(chartTicker, syminfo.ticker(assetTicker))
        result

// Count populated manual assets and determine chart membership
int populatedAssetCount = (str.length(psp_manual_asset1) > 0 ? 1 : 0) + (str.length(psp_manual_asset2) > 0 ? 1 : 0) + (str.length(psp_manual_asset3) > 0 ? 1 : 0)
bool matchesAsset1 = matchAsset(psp_manual_asset1)
bool matchesAsset2 = matchAsset(psp_manual_asset2)
bool matchesAsset3 = matchAsset(psp_manual_asset3)
bool chartInManualAssets = matchesAsset1 or matchesAsset2 or matchesAsset3
bool manualAssetsValid = assetPreset == 'Manual' and populatedAssetCount >= 2 and chartInManualAssets

// Dynamically reorder assets so chart becomes primary
// The invert_asset3 flag follows the original Asset 3 to its new position
string resolvedPrimary = ''
string resolvedSecondary = ''
string resolvedTertiary = ''
bool resolvedInvertSecondary = false
bool resolvedInvertTertiary = false

if manualAssetsValid
    // Chart is primary - determine which asset matches and reorder
    if matchesAsset1
        resolvedPrimary := psp_manual_asset1
        resolvedSecondary := str.length(psp_manual_asset2) > 0 ? psp_manual_asset2 : psp_manual_asset3
        resolvedTertiary := str.length(psp_manual_asset2) > 0 and str.length(psp_manual_asset3) > 0 ? psp_manual_asset3 : ''
        // Asset 3's invert flag moves with it
        resolvedInvertSecondary := str.length(psp_manual_asset2) == 0 and psp_invert_asset3  // Asset 3 moved to secondary
        resolvedInvertTertiary := str.length(psp_manual_asset2) > 0 and psp_invert_asset3   // Asset 3 stays tertiary
    else if matchesAsset2
        resolvedPrimary := psp_manual_asset2
        resolvedSecondary := str.length(psp_manual_asset1) > 0 ? psp_manual_asset1 : psp_manual_asset3
        resolvedTertiary := str.length(psp_manual_asset1) > 0 and str.length(psp_manual_asset3) > 0 ? psp_manual_asset3 : ''
        // Asset 3's invert flag moves with it
        resolvedInvertSecondary := str.length(psp_manual_asset1) == 0 and psp_invert_asset3  // Asset 3 moved to secondary
        resolvedInvertTertiary := str.length(psp_manual_asset1) > 0 and psp_invert_asset3   // Asset 3 stays tertiary
    else if matchesAsset3
        // Chart matches Asset 3 (the inverted asset) - it becomes primary
        // When an inverted asset is the chart, we need to invert the OTHER assets instead
        resolvedPrimary := psp_manual_asset3
        resolvedSecondary := str.length(psp_manual_asset1) > 0 ? psp_manual_asset1 : psp_manual_asset2
        resolvedTertiary := str.length(psp_manual_asset1) > 0 and str.length(psp_manual_asset2) > 0 ? psp_manual_asset2 : ''
        // Asset 3 was marked as inverted, but now it's the primary (chart)
        // The relationship is inverted, so we must invert the secondary/tertiary assets instead
        resolvedInvertSecondary := psp_invert_asset3  // If Asset 3 was inverted, now invert the others
        resolvedInvertTertiary := psp_invert_asset3   // Same for tertiary

// Apply universal PSP settings to all HTF divergence settings
// Note: manual_asset1/2/3 are assigned the resolved (reordered) values when in manual mode
DivSettingsHTF1.applyUniversalPSP(assetPreset, psp_mode, psp_precise_mode, psp_faster_detection, resolvedInvertTertiary, psp_bull_div_body, psp_bear_div_body, resolvedPrimary, resolvedSecondary, resolvedTertiary)
DivSettingsHTF2.applyUniversalPSP(assetPreset, psp_mode, psp_precise_mode, psp_faster_detection, resolvedInvertTertiary, psp_bull_div_body, psp_bear_div_body, resolvedPrimary, resolvedSecondary, resolvedTertiary)
DivSettingsHTF3.applyUniversalPSP(assetPreset, psp_mode, psp_precise_mode, psp_faster_detection, resolvedInvertTertiary, psp_bull_div_body, psp_bear_div_body, resolvedPrimary, resolvedSecondary, resolvedTertiary)
DivSettingsHTF4.applyUniversalPSP(assetPreset, psp_mode, psp_precise_mode, psp_faster_detection, resolvedInvertTertiary, psp_bull_div_body, psp_bear_div_body, resolvedPrimary, resolvedSecondary, resolvedTertiary)
DivSettingsHTF5.applyUniversalPSP(assetPreset, psp_mode, psp_precise_mode, psp_faster_detection, resolvedInvertTertiary, psp_bull_div_body, psp_bear_div_body, resolvedPrimary, resolvedSecondary, resolvedTertiary)
